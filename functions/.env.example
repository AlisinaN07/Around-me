# Cloudflare R2 — SERVER-SIDE-ONLY configuration (Step 4 foundation).
# Read by functions/src/media/r2Config.ts. Several deployed Cloud
# Functions already depend on this — requestMediaUploadAuthorization,
# discardReelSource, deleteStoryMedia, deleteOwnMedia, muxReelMusic,
# renderPhotoToVideo, finalizeReelVideo, finalizeStoryVideo,
# addReelToMyStory, cleanupExpiredStories, deleteMyAccountData,
# deleteMyReel, and removeReportedReel all bind the two secret values
# below and call into functions/src/media/r2Storage.ts (which is
# intentionally still NOT exported from functions/src/index.ts itself —
# only reached through those narrow, validated callables/triggers, never
# directly). Leaving every value below unset still degrades safely
# (getR2Config() returns null, and every R2-aware code path falls back to
# its existing Firebase Storage behavior — see each file's own doc
# comment), but it is no longer true that nothing depends on this.
#
# NEVER give these an EXPO_PUBLIC_ prefix, and never copy them into the
# app's own .env.example / .env.local — that would bundle them into the
# mobile client's JS bundle, which must never hold permanent R2
# credentials. These belong only in this backend's own environment.
#
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are genuine long-lived
# credentials — in a real deployment, set them via Firebase's Secret
# Manager integration instead of a committed/plain .env file:
#
#   firebase functions:secrets:set R2_ACCESS_KEY_ID
#   firebase functions:secrets:set R2_SECRET_ACCESS_KEY
#
# Copy this file to functions/.env.local for local emulator use only, and
# fill in real values there. Never commit functions/.env.local. Never
# commit real credentials anywhere in this repository.

# Cloudflare account ID (Cloudflare dashboard → R2 → Overview, right
# sidebar). Not a secret, but still kept server-side for simplicity/
# consistency with the other R2 values.
R2_ACCOUNT_ID=

# The R2 bucket name Around Me's media will eventually live in.
R2_BUCKET_NAME=

# R2 API token credentials (Cloudflare dashboard → R2 → Manage API
# tokens → create a token scoped to Object Read & Write on this bucket
# only — see the Step 4 report's own Cloudflare setup plan for the
# exact permission scope). Genuine secrets — see this file's own header
# comment on how to set these for a real deployment.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional — a future public/CDN base URL for PUBLIC media once a custom
# media domain exists (see the Step 4 report). Leave unset until then;
# never point this at a raw *.r2.dev URL in production.
R2_PUBLIC_MEDIA_BASE_URL=
