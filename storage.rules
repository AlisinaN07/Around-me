rules_version = '2';

// Cloud Storage Rules for Around Me — Step 18 Reels media only. Every
// other path is denied by the catch-all at the bottom.
//
// Cross-service reads use firestore.get()/firestore.exists() — Firebase's
// documented mechanism for a Storage rule to read a Firestore document
// (see firebase-tools' own default storage.rules template). This
// requires the project's Cloud Storage service agent
// (service-<PROJECT_NUMBER>@gcp-sa-firebasestorage.iam.gserviceaccount.com)
// to hold the `roles/firebaserules.firestoreServiceAgent` IAM role —
// Firebase's own documented role for this exact purpose (grants only
// `datastore.entities.get`). That binding was missing on this project
// through Step 18 (the Firebase Console's interactive "Publish" flow is
// what normally prompts you to add it; deploying via `firebase-tools`
// from the CLI, as this project always has, does not trigger that
// prompt — confirmed empirically in Step 18.1 with `--debug` deploy
// output showing no IAM-related call at all). Once the role was granted
// (Step 18.1, owner action), a dedicated diagnostic confirmed both
// firestore.exists() and firestore.get() work correctly. An earlier,
// incorrect hypothesis in this file blamed a Firestore/Storage region
// mismatch (europe-north2 vs. US-EAST1) — that was never an officially
// documented requirement and is not the cause; cross-region reads only
// add latency (Google's own docs cite ~75ms per Firestore read), never
// an authorization failure. The bucket's region was correctly left
// unchanged throughout.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function reelPath(reelId) {
      return /databases/(default)/documents/reels/$(reelId);
    }

    function reelExists(reelId) {
      return firestore.exists(reelPath(reelId));
    }

    // Multiple firestore.get() calls against the SAME document within one
    // rule evaluation are cached (Firebase enforces a 2-unique-document
    // limit per evaluation, not a call-count limit) — so referencing this
    // helper several times below costs one Firestore read, not several.
    function reelDoc(reelId) {
      return firestore.get(reelPath(reelId)).data;
    }

    // reels/{authorUid}/{reelId}/source — the one Reel media object per
    // Reel (see src/services/reels.ts's reelStoragePath). Deterministic
    // and ownership-aware: never derived from a user-supplied filename,
    // and now independently cross-checked against the actual Firestore
    // reels/{reelId} document on every operation below.
    match /reels/{authorUid}/{reelId}/source {
      // Only published Reel media is readable, by any authenticated
      // user. The app never needs the author to read their own
      // still-uploading object via Storage (the Create Reel screen
      // previews from the local picked file, not from Storage — see
      // src/app/(app)/create/reel.tsx — and resolveReelPlaybackUrl in
      // src/services/reels.ts is only ever called for Reels already
      // rendered from the published feed), so no such carve-out is
      // granted: least privilege, not "might be useful later."
      allow read: if isSignedIn()
        && reelExists(reelId)
        && reelDoc(reelId).status == 'published';

      // The upload itself. Requires:
      //  - the caller to own this exact author path
      //  - `resource == null` — Cloud Storage has no real distinct
      //    "update file content" operation; a second upload to an
      //    existing path is STILL evaluated under this same `create`
      //    rule (verified empirically in Step 18), not routed to `allow
      //    update` — so this is what actually makes uploads create-once
      //  - actual (not client-claimed) size and content type, enforced
      //    by Storage itself via request.resource
      //  - a matching Firestore reels/{reelId} document that is still
      //    "uploading", really owned by this authorUid, and whose own
      //    storagePath field exactly equals this object's path — so an
      //    upload can never happen before its Firestore draft exists,
      //    into someone else's author path, or against an already
      //    (or never) "uploading" Reel.
      allow create: if isSignedIn()
        && request.auth.uid == authorUid
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*')
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).reelId == reelId
        && reelDoc(reelId).status == 'uploading'
        && reelDoc(reelId).storagePath == 'reels/' + authorUid + '/' + reelId + '/source';

      // No metadata-only changes to an existing object either.
      allow update: if false;

      // Failed/cancelled-upload cleanup only, while the Reel draft is
      // still "uploading" — see discardReelDraft in src/services/reels.ts.
      // Once published, ordinary clients can never delete Reel media —
      // there is no trusted media + Firestore cascade-deletion workflow
      // yet (see the Step 18 spec).
      allow delete: if isSignedIn()
        && request.auth.uid == authorUid
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).status == 'uploading';
    }

    // Everything else — including the bucket root and any other path —
    // is denied by default. No public/open bucket access of any kind.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
