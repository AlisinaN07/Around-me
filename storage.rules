rules_version = '2';

// Cloud Storage Rules for Around Me — Step 18 Reels media only. Every
// other path is denied by the catch-all at the bottom.
//
// Cross-service reads use firestore.get()/firestore.exists() — Firebase's
// documented mechanism for a Storage rule to read a Firestore document
// (see firebase-tools' own default storage.rules template). This
// requires the project's Cloud Storage service agent
// (service-<PROJECT_NUMBER>@gcp-sa-firebasestorage.iam.gserviceaccount.com)
// to hold the `roles/firebaserules.firestoreServiceAgent` IAM role —
// Firebase's own documented role for this exact purpose (grants only
// `datastore.entities.get`). That binding was missing on this project
// through Step 18 (the Firebase Console's interactive "Publish" flow is
// what normally prompts you to add it; deploying via `firebase-tools`
// from the CLI, as this project always has, does not trigger that
// prompt — confirmed empirically in Step 18.1 with `--debug` deploy
// output showing no IAM-related call at all). Once the role was granted
// (Step 18.1, owner action), a dedicated diagnostic confirmed both
// firestore.exists() and firestore.get() work correctly. An earlier,
// incorrect hypothesis in this file blamed a Firestore/Storage region
// mismatch (europe-north2 vs. US-EAST1) — that was never an officially
// documented requirement and is not the cause; cross-region reads only
// add latency (Google's own docs cite ~75ms per Firestore read), never
// an authorization failure. The bucket's region was correctly left
// unchanged throughout.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function reelPath(reelId) {
      return /databases/(default)/documents/reels/$(reelId);
    }

    function reelExists(reelId) {
      return firestore.exists(reelPath(reelId));
    }

    // Multiple firestore.get() calls against the SAME document within one
    // rule evaluation are cached (Firebase enforces a 2-unique-document
    // limit per evaluation, not a call-count limit) — so referencing this
    // helper several times below costs one Firestore read, not several.
    function reelDoc(reelId) {
      return firestore.get(reelPath(reelId)).data;
    }

    // reels/{authorUid}/{reelId}/source — the one Reel media object per
    // Reel (see src/services/reels.ts's reelStoragePath). Deterministic
    // and ownership-aware: never derived from a user-supplied filename,
    // and now independently cross-checked against the actual Firestore
    // reels/{reelId} document on every operation below.
    match /reels/{authorUid}/{reelId}/source {
      // Only published Reel media is readable, by any authenticated
      // user. The app never needs the author to read their own
      // still-uploading object via Storage (the Create Reel screen
      // previews from the local picked file, not from Storage — see
      // src/app/(app)/create/reel.tsx — and resolveReelPlaybackUrl in
      // src/services/reels.ts is only ever called for Reels already
      // rendered from the published feed), so no such carve-out is
      // granted: least privilege, not "might be useful later."
      allow read: if isSignedIn()
        && reelExists(reelId)
        && reelDoc(reelId).status == 'published';

      // The upload itself. Requires:
      //  - the caller to own this exact author path
      //  - `resource == null` — Cloud Storage has no real distinct
      //    "update file content" operation; a second upload to an
      //    existing path is STILL evaluated under this same `create`
      //    rule (verified empirically in Step 18), not routed to `allow
      //    update` — so this is what actually makes uploads create-once
      //  - actual (not client-claimed) size and content type, enforced
      //    by Storage itself via request.resource
      //  - a matching Firestore reels/{reelId} document that is still
      //    "uploading", really owned by this authorUid, and whose own
      //    storagePath field exactly equals this object's path — so an
      //    upload can never happen before its Firestore draft exists,
      //    into someone else's author path, or against an already
      //    (or never) "uploading" Reel.
      // Step: "FOTO" mode — a single still image is also a valid Reel
      // media object at this same path (see src/types/reel.ts's
      // ReelMediaType doc comment), with its own smaller size cap; the
      // Firestore document's own mediaType decides which content-type/size
      // rule actually applies, exactly like isValidReelCreate does
      // server-side on the Firestore document itself.
      //
      // Step — renderPhotoToVideo: a "FOTO" photo taken WITH music is a
      // 'video' mediaType Reel from the moment its draft exists (see
      // Reel.needsPhotoVideoRender's own doc comment), but the upload
      // landing HERE, before renderPhotoToVideo has run, is still the
      // original photo — so it needs the same image bounds as a plain
      // 'photo' Reel, not the video bounds a 'video' mediaType would
      // otherwise require. renderPhotoToVideo itself writes the eventual
      // real video to this exact path via the Admin SDK, which bypasses
      // these Rules entirely, so no separate allowance is needed for that
      // write.
      allow create: if isSignedIn()
        && request.auth.uid == authorUid
        && resource == null
        && request.resource.size > 0
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).reelId == reelId
        && reelDoc(reelId).status == 'uploading'
        && reelDoc(reelId).storagePath == 'reels/' + authorUid + '/' + reelId + '/source'
        && (
          (reelDoc(reelId).mediaType == 'photo' && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || (reelDoc(reelId).mediaType == 'video' && reelDoc(reelId).needsPhotoVideoRender == true && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || (reelDoc(reelId).mediaType == 'video' && reelDoc(reelId).needsPhotoVideoRender != true && request.resource.size <= 50 * 1024 * 1024 && request.resource.contentType.matches('video/.*'))
        );

      // No metadata-only changes to an existing object either.
      allow update: if false;

      // Failed/cancelled-upload cleanup only, while the Reel draft is
      // still "uploading" — see discardReelDraft in src/services/reels.ts.
      // Once published, ordinary clients can never delete Reel media —
      // there is no trusted media + Firestore cascade-deletion workflow
      // yet (see the Step 18 spec).
      allow delete: if isSignedIn()
        && request.auth.uid == authorUid
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).status == 'uploading';
    }

    // reels/{authorUid}/{reelId}/music — device-picked background music
    // (see src/types/reel.ts's ReelMusicSourceType), a SEPARATE object
    // from /source above, only ever present when the Firestore document's
    // own musicSourceType == 'device'. Otherwise an exact structural
    // mirror of /source's own rules — same ownership/deterministic-path/
    // status checks, just against the music fields instead of the video
    // ones.
    match /reels/{authorUid}/{reelId}/music {
      allow read: if isSignedIn()
        && reelExists(reelId)
        && reelDoc(reelId).status == 'published';

      allow create: if isSignedIn()
        && request.auth.uid == authorUid
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*')
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).reelId == reelId
        && reelDoc(reelId).status == 'uploading'
        && reelDoc(reelId).musicSourceType == 'device'
        && reelDoc(reelId).musicStorageAudioPath == 'reels/' + authorUid + '/' + reelId + '/music';

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == authorUid
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).status == 'uploading';
    }

    // reels/{authorUid}/{reelId}/thumbnail — the real still frame the
    // author chose from their own video as its cover (see
    // src/utils/reelThumbnailCandidates.ts and Reel.thumbnailStoragePath's
    // own doc comment). Always present on every Reel created after this
    // field was introduced — unlike /music, never conditional on a source
    // type. Otherwise an exact structural mirror of /source and /music
    // above, against the thumbnail fields instead.
    match /reels/{authorUid}/{reelId}/thumbnail {
      allow read: if isSignedIn()
        && reelExists(reelId)
        && reelDoc(reelId).status == 'published';

      allow create: if isSignedIn()
        && request.auth.uid == authorUid
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).reelId == reelId
        && reelDoc(reelId).status == 'uploading'
        && reelDoc(reelId).thumbnailStoragePath == 'reels/' + authorUid + '/' + reelId + '/thumbnail';

      allow update: if false;

      allow delete: if isSignedIn()
        && request.auth.uid == authorUid
        && reelExists(reelId)
        && reelDoc(reelId).authorUid == authorUid
        && reelDoc(reelId).status == 'uploading';
    }

    // soundOrigins/{musicHash}/audio — the ONE permanent copy of a given
    // sound's actual audio bytes, kept the first time its hash is ever
    // seen (see Reel.musicHash's own doc comment in src/types/reel.ts and
    // soundOriginAudioStoragePath in functions/src/index.ts). Only ever
    // written by trusted Cloud Functions via the Admin SDK, which bypasses
    // these Rules entirely — `allow write: if false` here is about
    // ordinary clients, not about blocking the functions themselves.
    // Readable by any signed-in user: reusing a sound for a new post
    // ("Use audio" in src/components/SoundSheet.tsx) needs no more
    // privacy than seeing the Reels that already used it publicly.
    match /soundOrigins/{musicHash}/audio {
      allow read: if isSignedIn();
      allow write: if false;
    }

    function storyPath(storyId) {
      return /databases/(default)/documents/stories/$(storyId);
    }

    function storyExists(storyId) {
      return firestore.exists(storyPath(storyId));
    }

    function storyDoc(storyId) {
      return firestore.get(storyPath(storyId)).data;
    }

    function followEdgeExists(followerUid, followingUid) {
      return firestore.exists(/databases/(default)/documents/follows/$(followerUid + '_' + followingUid));
    }

    // stories/{authorUid}/{storyId}/source — the one Story media object per
    // Story (see src/services/stories.ts's storyStoragePath). Mirrors the
    // Reels /source block above, with one key difference: Stories are
    // followers-only, not public-within-app, so a read ALSO requires a
    // real follow edge from the requester to the author — not just
    // "published." This file's own header comment documents a hard cap of
    // 2 UNIQUE cross-service documents per rule evaluation — storyDoc(...)
    // and the follow-edge check below are exactly those 2, leaving no
    // budget for a separate, third block-graph lookup here. That's not a
    // gap: blocking always deletes BOTH follow edges atomically (see
    // src/services/blocks.ts) — a blocked relationship can never have a
    // real follow edge to satisfy the check below in the first place, so
    // the same block outcome is enforced transitively, at no extra cost.
    match /stories/{authorUid}/{storyId}/source {
      allow read: if isSignedIn()
        && storyExists(storyId)
        && storyDoc(storyId).authorUid == authorUid
        && (
          request.auth.uid == authorUid
          || (storyDoc(storyId).status == 'published' && followEdgeExists(request.auth.uid, authorUid))
        );

      allow create: if isSignedIn()
        && request.auth.uid == authorUid
        && resource == null
        && request.resource.size > 0
        && storyExists(storyId)
        && storyDoc(storyId).authorUid == authorUid
        && storyDoc(storyId).storyId == storyId
        && storyDoc(storyId).status == 'uploading'
        && storyDoc(storyId).storagePath == 'stories/' + authorUid + '/' + storyId + '/source'
        && (
          (storyDoc(storyId).mediaType == 'photo' && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || (storyDoc(storyId).mediaType != 'photo' && request.resource.size <= 50 * 1024 * 1024 && request.resource.contentType.matches('video/.*'))
        );

      allow update: if false;

      // Deletable while "uploading" (failed/cancelled-upload cleanup) OR
      // at any time once published — the author's own "delete my Story"
      // (deleteMyStory in src/services/stories.ts). Unlike a Reel, which
      // can never be client-deleted once published, a Story has no
      // cascade (no likes/comments/thumbnail/music) to worry about.
      allow delete: if isSignedIn()
        && request.auth.uid == authorUid
        && storyExists(storyId)
        && storyDoc(storyId).authorUid == authorUid;
    }

    // profilePhotos/{uid}/photo — Edit Profile's picture upload. A single
    // deterministic object per user (never per-upload), unlike the Reel
    // paths above: a profile photo is meant to be replaced in place, not
    // created once and left immutable, so — unlike /source, /music, and
    // /thumbnail — this allows `update` too, under the exact same
    // ownership/size/content-type checks as `create`. No Firestore
    // cross-check is needed the way Reels need one: the path itself
    // already encodes the only ownership fact that matters (request.auth.uid
    // == uid), there's no "draft" lifecycle to gate against, and the
    // resulting download URL is written back to users/{uid}.photoURL +
    // publicProfiles/{uid}.photoURL by updateMyProfilePhoto in
    // src/services/userProfile.ts right after a successful upload.
    match /profilePhotos/{uid}/photo {
      // Public-safe by product design (it mirrors publicProfiles/{uid},
      // itself readable by any signed-in user) — same isSignedIn() gate as
      // every other read above, not stricter.
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // profileCovers/{uid}/photo — Edit Profile's cover/banner picture
    // upload, shown behind the avatar on the Profile header (see
    // ProfileHeader.tsx). Exact structural mirror of profilePhotos/{uid}/
    // photo above — same deterministic single-object-per-user path, same
    // create/update/delete-by-owner rules, same public-safe read gate —
    // just a larger size cap (a banner is a wider image) and written back
    // to users/{uid}.coverPhotoURL + publicProfiles/{uid}.coverPhotoURL by
    // updateMyProfileCoverPhoto instead.
    match /profileCovers/{uid}/photo {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Everything else — including the bucket root and any other path —
    // is denied by default. No public/open bucket access of any kind.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
