rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validates that a field was set via serverTimestamp(), not an
    // arbitrary client-supplied value.
    function isServerTimestamp(value) {
      return value == request.time;
    }

    // users/{uid} — private profile, readable and creatable only by its
    // own owner. No update/delete yet: profile editing is a future step
    // with its own explicit rules.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.cityName is string
        && request.resource.data.countryCode is string
        && request.resource.data.cityKey is string
        && request.resource.data.interests is list
        && request.resource.data.accountType == 'personal'
        && request.resource.data.onboardingCompleted is bool
        && isServerTimestamp(request.resource.data.createdAt)
        && isServerTimestamp(request.resource.data.updatedAt)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username', 'usernameLower',
          'cityName', 'countryCode', 'cityKey', 'interests',
          'accountType', 'onboardingCompleted', 'createdAt', 'updatedAt'
        ]);
    }

    // usernames/{usernameLower} — a uniqueness index. Any signed-in user
    // may check whether a single username is taken (get, not list); only
    // the reserving user may create their own reservation, and it can
    // never be updated or deleted once created.
    match /usernames/{usernameLower} {
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && usernameLower.matches('^[a-z0-9_]{3,24}$')
        && isServerTimestamp(request.resource.data.createdAt)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
    }

    // content/{contentId} — the unified root collection for posts,
    // activities, and events (see src/types/content.ts). Every document's
    // author/city fields are validated against the author's own private
    // users/{uid} profile below, so a modified client can never impersonate
    // another user or another city — without making users/{uid} itself
    // publicly readable.
    match /content/{contentId} {
      // Base field set shared by every content type.
      function baseContentKeys() {
        return [
          'contentId', 'type', 'authorUid', 'authorDisplayName', 'authorUsername',
          'cityName', 'countryCode', 'cityKey', 'categoryId',
          'status', 'visibility', 'createdAt', 'updatedAt'
        ];
      }

      function isValidPostShape(data) {
        return data.type == 'post'
          && data.body is string
          && data.body.size() > 0
          && data.body.size() <= 1000
          && data.keys().hasAll(baseContentKeys().concat(['body']))
          && data.keys().hasOnly(baseContentKeys().concat(['body', 'placeName']))
          && (!('placeName' in data) || (data.placeName is string && data.placeName.size() <= 200));
      }

      function isValidActivityShape(data) {
        return data.type == 'activity'
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
          && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 200
          && data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.startsAt < data.endsAt
          && data.keys().hasAll(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName']))
          && data.keys().hasOnly(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName', 'maxParticipants']))
          && (!('maxParticipants' in data) || (data.maxParticipants is int && data.maxParticipants > 0 && data.maxParticipants <= 500));
      }

      function isValidEventShape(data) {
        return data.type == 'event'
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
          && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 200
          && data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.startsAt < data.endsAt
          && data.keys().hasAll(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName']))
          && data.keys().hasOnly(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName']));
      }

      // Fetches the caller's own private profile once (Firestore rules
      // cache repeated get()/exists() calls to the same path within one
      // evaluation, so this costs a single read regardless of how many
      // times `profile` is referenced below) and checks the full author +
      // city snapshot on the incoming document against it.
      function isValidContentCreate(data) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && profile.onboardingCompleted == true
          && data.contentId == contentId
          && data.authorUid == request.auth.uid
          && data.authorDisplayName == profile.displayName
          && data.authorUsername == profile.username
          && data.cityName == profile.cityName
          && data.countryCode == profile.countryCode
          && data.cityKey == profile.cityKey
          && data.status == 'published'
          && data.visibility == 'city'
          && data.categoryId is string
          && data.categoryId.size() > 0
          && isServerTimestamp(data.createdAt)
          && isServerTimestamp(data.updatedAt)
          && (isValidPostShape(data) || isValidActivityShape(data) || isValidEventShape(data));
      }

      // Published content is readable by any signed-in user (this also
      // governs list/query results — Firestore evaluates this per matched
      // document). Not scoped to the reader's own city: browsing other
      // cities is part of the product.
      allow read: if isSignedIn() && resource.data.status == 'published';

      allow create: if isSignedIn() && isValidContentCreate(request.resource.data);

      // No edit UI exists yet, so there's nothing to validate "which
      // fields are safely mutable" against — deny entirely for now rather
      // than design that validation speculatively. Revisit when an actual
      // edit flow exists.
      allow update: if false;

      allow delete: if isOwner(resource.data.authorUid);
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
