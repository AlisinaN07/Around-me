rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validates that a field was set via serverTimestamp(), not an
    // arbitrary client-supplied value.
    function isServerTimestamp(value) {
      return value == request.time;
    }

    // users/{uid} — private profile, readable and creatable only by its
    // own owner. Step 33 adds a narrow owner-only update for Edit Profile
    // (see below) — every other field stays immutable after create.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.cityName is string
        && request.resource.data.countryCode is string
        && request.resource.data.cityKey is string
        && request.resource.data.interests is list
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.coverPhotoURL is string
        && request.resource.data.coverPhotoURL.size() <= 2048
        // Step 30: Around Me supports exactly two account types, chosen
        // once during onboarding — no arbitrary string (e.g. 'admin',
        // 'organizer', 'verified_business') is ever accepted. The Edit
        // Profile `allow update` below still asserts accountType unchanged
        // (Section 14), and a dedicated second `allow update` (Step 35)
        // permits exactly one further transition — personal -> business,
        // never the reverse — so accountType only ever moves in one
        // direction after create, and only through that one narrow path.
        && (request.resource.data.accountType == 'personal' || request.resource.data.accountType == 'business')
        && request.resource.data.onboardingCompleted is bool
        && isServerTimestamp(request.resource.data.createdAt)
        && isServerTimestamp(request.resource.data.updatedAt)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username', 'usernameLower',
          'cityName', 'countryCode', 'cityKey', 'interests', 'bio', 'photoURL', 'coverPhotoURL',
          'accountType', 'onboardingCompleted', 'createdAt', 'updatedAt'
        ]);

      // Step 33 — Edit Profile. Only displayName, username/usernameLower
      // (always updated as a matched pair — see updateMyProfile), bio,
      // interests, photoURL (see updateMyProfilePhoto), and coverPhotoURL
      // (see updateMyProfileCoverPhoto) may change. Every other field must
      // be byte-identical to its prior value: uid/email/cityName/
      // countryCode/cityKey (Home City is not editable in this step —
      // Section 15), accountType (still immutable — Section 14),
      // onboardingCompleted, and createdAt.
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.cityName == resource.data.cityName
        && request.resource.data.countryCode == resource.data.countryCode
        && request.resource.data.cityKey == resource.data.cityKey
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.onboardingCompleted == resource.data.onboardingCompleted
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.interests is list
        && request.resource.data.interests.size() >= 3
        && request.resource.data.interests.size() <= 8
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.coverPhotoURL is string
        && request.resource.data.coverPhotoURL.size() <= 2048
        && isServerTimestamp(request.resource.data.updatedAt)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username', 'usernameLower',
          'cityName', 'countryCode', 'cityKey', 'interests', 'bio', 'photoURL', 'coverPhotoURL',
          'accountType', 'onboardingCompleted', 'createdAt', 'updatedAt'
        ]);

      // Step 35 — Settings -> Switch to Business account
      // (src/app/(app)/settings/business-account.tsx,
      // upgradeToBusinessAccount in src/services/userProfile.ts). A
      // SEPARATE, narrow `allow update` from the Edit Profile one above —
      // Firestore evaluates multiple `allow update` blocks for the same
      // match as OR, so this adds exactly one more permitted write without
      // touching the Edit Profile rule at all: accountType moving from
      // 'personal' to 'business', and ONLY that direction — there is no
      // rule anywhere that permits 'business' -> 'personal', so once this
      // write lands it can never be undone by the client. Every other
      // field must be byte-identical to its prior value, same
      // immutability guarantee Edit Profile provides for its own fields.
      allow update: if isOwner(uid)
        && resource.data.accountType == 'personal'
        && request.resource.data.accountType == 'business'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.cityName == resource.data.cityName
        && request.resource.data.countryCode == resource.data.countryCode
        && request.resource.data.cityKey == resource.data.cityKey
        && request.resource.data.interests == resource.data.interests
        && request.resource.data.bio == resource.data.bio
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.coverPhotoURL == resource.data.coverPhotoURL
        && request.resource.data.onboardingCompleted == resource.data.onboardingCompleted
        && request.resource.data.createdAt == resource.data.createdAt
        && isServerTimestamp(request.resource.data.updatedAt)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username', 'usernameLower',
          'cityName', 'countryCode', 'cityKey', 'interests', 'bio', 'photoURL', 'coverPhotoURL',
          'accountType', 'onboardingCompleted', 'createdAt', 'updatedAt'
        ]);

      // users/{uid}/saved/{savedId} — Step 41.2E. A private bookmark list:
      // ONLY the owner may ever read, create, or delete their own Saved
      // relationships — security does not depend on the Saved tab being
      // hidden from other users' own-profile views (it already is, but
      // that's UI, not the actual guarantee). No update is ever allowed —
      // a Saved relationship is create-or-delete only, exactly like a
      // Follow/Block/Like edge elsewhere in this file, so there is nothing
      // to "edit" and no way to silently mutate one into pointing at a
      // different target.
      match /saved/{savedId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && isValidSavedCreate(uid, savedId, request.resource.data);

        allow update: if false;

        allow delete: if isOwner(uid);
      }

      // users/{uid}/recommendationEvents/{eventId} — the "For You"
      // recommendation engine's own append-only interaction log (see
      // src/types/recommendation.ts). ONLY the owner may ever read or
      // create their own events, exactly like Saved above; never
      // updatable or deletable — a logged interaction is permanent, same
      // reasoning as a Like/Follow edge being create-or-delete-only
      // elsewhere in this file, except an interaction event isn't even
      // deletable (there is no "undo an impression").
      match /recommendationEvents/{eventId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && isValidRecommendationEventCreate(uid, request.resource.data);

        allow update: if false;

        allow delete: if false;
      }

      // users/{uid}/recommendationProfile/{docId} — the same engine's
      // single derived aggregate document (always docId == 'main' — see
      // RecommendationProfile's own doc comment). A pure cache of
      // recommendationEvents: safe to fully overwrite (never a partial
      // field-by-field diff to validate), so create/update share one
      // validation function. Bounded map/list sizes here mirror the
      // client's own trimming logic (interestProfile.ts) — this is a
      // defense-in-depth cap, not the only place size is kept small.
      //
      // Recommendation Engine — Step 5 — this SAME match block also
      // governs `recommendationProfile/collaborative` (the trusted
      // collaborative-filtering output — see functions/src/collaborative.ts
      // and src/types/collaborative.ts), and DELIBERATELY needed no
      // changes to support it: `allow read: if isOwner(uid)` already
      // covers any docId (owner-only, matching Step 30's "users may read
      // their own collaborative result"), while `create`/`update` are
      // already restricted to `docId == 'main'` — so a client attempting
      // to write `.../recommendationProfile/collaborative` is already
      // denied by the existing `docId == 'main'` check, with no special-
      // casing needed. Only the Admin SDK (functions/src/collaborative.ts,
      // which bypasses Rules entirely via IAM) can ever write it.
      match /recommendationProfile/{docId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && docId == 'main' && isValidRecommendationProfileWrite(request.resource.data);

        allow update: if isOwner(uid) && docId == 'main' && isValidRecommendationProfileWrite(request.resource.data);

        allow delete: if false;
      }

      // Recommendation Engine — hashtag interest profile —
      // users/{uid}/hashtagInterests/{hashtag}: per-user, per-hashtag
      // interest scores (see src/types/hashtagInterest.ts). A separate
      // SUBCOLLECTION rather than a map field on recommendationProfile/
      // main above — hashtag cardinality is unbounded (unlike the ~18-
      // entry category catalog categoryScores already covers), so it can
      // never be folded into that one bounded document the way
      // categoryScores/creatorScores/cityScores are.
      //
      // Owner-only, same as recommendationProfile/main just above — a
      // user can only ever read/corrupt THEIR OWN future recommendation
      // inputs this way (once a later step actually uses this for
      // ranking), never another user's data. Rules validates the SHAPE
      // and numeric BOUNDS (score clamped to [0,1], counts non-negative
      // integers, hashtag == this doc's own ID), not that a write exactly
      // replays the client's own bounded-delta math — impractical to
      // re-derive in Rules language, and unnecessary for the exact same
      // reason recommendationProfile/main just above already accepts this
      // same limitation (see isValidRecommendationProfileWrite's own doc
      // comment: this is a self-harm-only risk, not a cross-user one).
      // `allow delete` (unlike recommendationProfile/main's permanent
      // `false`) is real here — the client's own low-score cleanup
      // (hashtagInterestProfile.ts) deletes a hashtag whose score decayed/
      // dropped to negligible rather than keeping a near-zero record
      // forever.
      match /hashtagInterests/{hashtag} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) && isValidHashtagInterestWrite(hashtag, request.resource.data);

        allow update: if isOwner(uid) && isValidHashtagInterestWrite(hashtag, request.resource.data);

        allow delete: if isOwner(uid);
      }

      // Recommendation Engine — Step 6 — users/{uid}/feedSessions/{sessionId}:
      // the trusted, backend-only-maintained per-session evaluation
      // summary (see functions/src/metrics.ts — built incrementally from
      // the SAME trusted recommendationEvents stream, never written
      // directly by any client). Owner-read only, matching every other
      // derived-analytics doc in this file; NO client write path exists
      // at all (unlike recommendationProfile/main, which the client DOES
      // write via a transaction) — this is pure backend aggregation, so
      // create/update/delete are all unconditionally denied.
      match /feedSessions/{sessionId} {
        allow read: if isOwner(uid);

        allow create: if false;

        allow update: if false;

        allow delete: if false;
      }
    }

    // Recommendation Engine — Step 6 — recommendationMetrics/{docId}
    // (functions/src/metrics.ts's daily reels_*/events_* aggregates) is
    // DELIBERATELY given no match block here at all — same precedent as
    // `recommendationStatsEvents` (Step 4) and `systemMigrations`: a
    // collection with no matching rule is denied to every client by
    // Firestore's own default-deny, and only the Admin SDK (which
    // bypasses Rules via IAM) ever touches it. There is no per-user
    // breakdown in this collection to protect (Step 16) — it is
    // aggregate-only by construction, and the admin evaluation script
    // (scripts/evaluate-recommendations.cjs) reads it via the same
    // privileged CLI-OAuth mechanism this project's other admin scripts
    // already use, never through a client-facing read path.

    // Step "For You" recommendation engine — see src/types/recommendation.ts
    // and src/services/recommendations/. Every numeric/category/creator/
    // city field here is a derived, recomputable signal (never a public-
    // safe profile snapshot the way content/{contentId}'s author fields
    // are), so validation only needs to bound shape/size, not cross-check
    // it against another document.
    function isValidRecommendationAction(action) {
      return action in [
        'impression', 'video_started', 'quick_skip', 'open', 'watch_25', 'watch_50', 'watch_75', 'complete', 'rewatch',
        'like', 'unlike', 'save', 'unsave', 'share', 'comment', 'profile_open', 'follow', 'unfollow',
        'event_open', 'event_save', 'event_unsave', 'event_interested', 'event_going', 'not_interested'
      ];
    }

    function isValidRecommendationEventCreate(uid, data) {
      return data.userId == uid
        && data.contentId is string
        && (data.contentType == 'reel' || data.contentType == 'content')
        && isValidRecommendationAction(data.action)
        && data.categoryId is string
        && data.creatorId is string
        && data.cityKey is string
        && data.countryCode is string
        && data.weight is number
        && data.watchDurationMs is number
        && data.watchDurationMs >= 0
        && data.watchPercentage is number
        && data.watchPercentage >= 0
        && data.watchPercentage <= 1
        // Recommendation Engine — Step 6, Steps 18/19 — bounded, optional-
        // in-spirit (client sends 0/''-defaults when no ranked-item
        // context exists — see TrackInteractionInput's own doc comment)
        // DEVELOPMENT/analytics metadata. Never trusted for anything
        // beyond aggregate metrics — functions/src/metrics.ts is the only
        // reader, and it treats every field here as self-reported (same
        // MEDIUM trust level this collection already had before this
        // pass — see src/types/engagementStats.ts's own trust-level
        // documentation for the established precedent).
        && data.rankPosition is int && data.rankPosition >= 0 && data.rankPosition <= 1000
        && data.sourceTags is string && data.sourceTags.size() <= 200
        && data.bucket is string && data.bucket.size() <= 30
        && data.rankingVersion is string && data.rankingVersion.size() <= 30
        && data.experimentVariant is string && data.experimentVariant.size() <= 60
        && data.feedSessionId is string && data.feedSessionId.size() <= 100
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly([
          'eventId', 'userId', 'contentId', 'contentType', 'action', 'categoryId', 'creatorId',
          'cityKey', 'countryCode', 'weight', 'watchDurationMs', 'watchPercentage',
          'rankPosition', 'sourceTags', 'bucket', 'rankingVersion', 'experimentVariant', 'feedSessionId',
          'createdAt'
        ]);
    }

    function isValidRecommendationProfileWrite(data) {
      return data.categoryScores is map && data.categoryScores.size() <= 200
        && data.creatorScores is map && data.creatorScores.size() <= 100
        && data.cityScores is map && data.cityScores.size() <= 50
        && data.excludedContentIds is list && data.excludedContentIds.size() <= 300
        // Second pass, Step 4 — bounded the same way as excludedContentIds
        // above (owner-only write; a user can only ever corrupt their OWN
        // recommendation data this way, same risk level as the score maps
        // above, so this deliberately doesn't deep-validate every
        // recentImpressions entry's own {count, lastSeenAt} shape).
        && data.recentImpressions is map && data.recentImpressions.size() <= 200
        && data.stronglyEngagedContentIds is list && data.stronglyEngagedContentIds.size() <= 200
        && data.respondedEventIds is list && data.respondedEventIds.size() <= 200
        && data.interactionCount is number
        && data.lastDecayAt is number
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly([
          'categoryScores', 'creatorScores', 'cityScores', 'excludedContentIds', 'recentImpressions',
          'stronglyEngagedContentIds', 'respondedEventIds', 'interactionCount', 'lastDecayAt', 'updatedAt'
        ]);
    }

    // Recommendation Engine — hashtag interest profile — see
    // `match /hashtagInterests/{hashtag}` above for the full reasoning.
    // `hashtagId` is this document's own ID (the path segment), matching
    // the same "hashtag == doc ID, never a capitalization-variant
    // duplicate" convention the global `hashtags/{hashtagId}` collection
    // already uses (see that collection's own isValidHashtagShape,
    // further down in this file).
    function isValidHashtagInterestWrite(hashtagId, data) {
      return data.hashtag == hashtagId
        && data.score is number && data.score >= 0 && data.score <= 1
        && data.positiveSignalCount is int && data.positiveSignalCount >= 0
        && data.negativeSignalCount is int && data.negativeSignalCount >= 0
        && isServerTimestamp(data.lastInteractionAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly(['hashtag', 'score', 'positiveSignalCount', 'negativeSignalCount', 'lastInteractionAt', 'updatedAt']);
    }

    // Step 41.2E — target validation for a new Saved relationship. Rejects:
    // a missing target (exists() short-circuits before either get() below
    // ever runs against a nonexistent document), an unpublished/draft Reel,
    // a non-'post' legacy content document (Event, Activity — this is the
    // enforcement point that keeps Saved video-Post/text-Post-only), an
    // unpublished legacy Post, saving your own Post either way, and a
    // malformed/mismatched targetType or savedId. Firestore Rules cache
    // repeated get() calls to the same path within one evaluation, so
    // calling savedReelTarget/savedContentTarget more than once below costs
    // only one real read each.
    function savedReelTarget(targetId) {
      return get(/databases/$(database)/documents/reels/$(targetId)).data;
    }

    function savedContentTarget(targetId) {
      return get(/databases/$(database)/documents/content/$(targetId)).data;
    }

    function isValidSavedCreate(uid, savedId, data) {
      return data.targetType is string
        && data.targetId is string
        && data.targetId.size() > 0
        && savedId == (data.targetType + '_' + data.targetId)
        && isServerTimestamp(data.savedAt)
        && data.keys().hasOnly(['targetType', 'targetId', 'savedAt'])
        && (
          (data.targetType == 'reel'
            && exists(/databases/$(database)/documents/reels/$(data.targetId))
            && savedReelTarget(data.targetId).status == 'published'
            && savedReelTarget(data.targetId).authorUid != uid)
          || (data.targetType == 'post'
            && exists(/databases/$(database)/documents/content/$(data.targetId))
            && savedContentTarget(data.targetId).type == 'post'
            && savedContentTarget(data.targetId).status == 'published'
            && savedContentTarget(data.targetId).authorUid != uid)
          // A saved SOUND (see Reel.musicHash's own doc comment in
          // src/types/reel.ts) — targetId is the musicHash itself, not a
          // reelId/contentId. soundOrigins/{musicHash} is otherwise a
          // fully server-only collection (no client read/write rule at
          // all) — this exists() check is the one place a client's write
          // is allowed to depend on it, just to confirm the hash is a
          // real known sound, never an arbitrary string.
          || (data.targetType == 'sound'
            && exists(/databases/$(database)/documents/soundOrigins/$(data.targetId)))
        );
    }

    // usernames/{usernameLower} — a uniqueness index. Any signed-in user
    // may check whether a single username is taken (get, not list); only
    // the reserving user may create their own reservation, and it can
    // never be updated once created. Step 33 adds a narrow delete: a user
    // may remove ONLY a reservation that says it's theirs, and ONLY as
    // part of the same atomic write that changes their users/{uid}
    // usernameLower to something else (getAfter() sees the post-commit
    // value from the paired users/{uid} update in the same transaction —
    // same technique isValidPublicProfileCreate already uses below). This
    // means: no stealing another user's reservation, no deleting your own
    // CURRENT reservation while leaving users/{uid} pointed at it, and no
    // deletion at all outside a real rename.
    match /usernames/{usernameLower} {
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && usernameLower.matches('^[a-z0-9_]{3,24}$')
        && isServerTimestamp(request.resource.data.createdAt)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower != usernameLower;
    }

    // publicProfiles/{uid} — the social-facing counterpart to the private
    // users/{uid} document (see src/types/social.ts). Only public-safe
    // fields, never email/GPS/tokens/private settings. Every field is
    // validated server-side against the caller's own private profile on
    // create, so a modified client can never publish someone else's name,
    // a different city, or a fabricated identity. users/{uid} itself stays
    // fully private — this collection exists specifically so we never have
    // to make it publicly readable.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isValidPublicProfileCreate(uid, request.resource.data);

      // Step 33 — Edit Profile mirror. The same atomic write that updates
      // users/{uid} also updates publicProfiles/{uid} (see updateMyProfile)
      // — getAfter() reads that post-commit users/{uid} document, so this
      // rule can require the two stay in lockstep without a separate get().
      allow update: if isOwner(uid) && isValidPublicProfileUpdate(uid, request.resource.data, resource.data);

      // Social identity documents aren't independently erasable from
      // account lifecycle yet.
      allow delete: if false;
    }

    function isValidPublicProfileCreate(uid, data) {
      // getAfter()/existsAfter(), not get()/exists(): the atomic onboarding
      // transaction creates users/{uid} and publicProfiles/{uid} together in
      // one transaction, so a plain get() here would only see the
      // pre-transaction snapshot — users/{uid} wouldn't exist yet from that
      // vantage point for a brand-new user, and this would always fail. This
      // is the exact same pairing pattern as the participants/stats rules.
      let profile = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return existsAfter(/databases/$(database)/documents/users/$(uid))
        && profile.onboardingCompleted == true
        && data.uid == uid
        && data.displayName == profile.displayName
        && data.username == profile.username
        && data.usernameLower == profile.usernameLower
        && data.cityName == profile.cityName
        && data.countryCode == profile.countryCode
        && data.cityKey == profile.cityKey
        && data.interests == profile.interests
        && data.bio == profile.bio
        && data.photoURL == profile.photoURL
        && data.coverPhotoURL == profile.coverPhotoURL
        && data.accountType == profile.accountType
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'cityName',
          'countryCode', 'cityKey', 'interests', 'bio', 'photoURL', 'coverPhotoURL', 'accountType', 'createdAt', 'updatedAt'
        ]);
    }

    // Step 33 — mirrors isValidPublicProfileCreate's shape/consistency
    // checks for the update path: the editable fields must match the
    // post-commit users/{uid} document exactly, and every immutable field
    // (cityName/countryCode/cityKey/createdAt) must be unchanged from what
    // publicProfiles/{uid} already had — a client can never use this
    // update to drift the public mirror away from the private profile, or
    // to change something Edit Profile doesn't cover.
    //
    // accountType is the one exception (Step 35): rather than pinning it
    // to its OLD value here too, it's asserted equal to the post-commit
    // users/{uid} value instead — exactly the same rule
    // isValidPublicProfileCreate already uses. This has no effect on Edit
    // Profile's own update (which never touches accountType on either
    // document, so the post-commit users/{uid} value is simply whatever it
    // already was), but it's what lets the SAME transaction that performs
    // the personal -> business upgrade on users/{uid} also update this
    // mirror to match, without a second, duplicate allow-block here.
    function isValidPublicProfileUpdate(uid, data, oldData) {
      let profile = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return data.uid == oldData.uid
        && data.cityName == oldData.cityName
        && data.countryCode == oldData.countryCode
        && data.cityKey == oldData.cityKey
        && data.accountType == profile.accountType
        && data.createdAt == oldData.createdAt
        && data.displayName == profile.displayName
        && data.username == profile.username
        && data.usernameLower == profile.usernameLower
        && data.interests == profile.interests
        && data.bio == profile.bio
        && data.photoURL == profile.photoURL
        && data.coverPhotoURL == profile.coverPhotoURL
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'cityName',
          'countryCode', 'cityKey', 'interests', 'bio', 'photoURL', 'coverPhotoURL', 'accountType', 'createdAt', 'updatedAt'
        ]);
    }

    // follows/{followerUid}_{followingUid} — a directed edge in the social
    // graph (see src/services/following.ts). The deterministic ID is what
    // guarantees at most one follow per (follower, following) pair: a
    // second create attempt for the same pair lands on the same document,
    // which is a rules "update" (denied below), not a second "create".
    match /follows/{followId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isValidFollowCreate(followId, request.resource.data);

      allow update: if false;

      // Only the follower can remove their own follow — a followed user
      // can't unilaterally strip someone else's follow edge, UNLESS
      // they're the one being followed and are blocking the follower in
      // the very same atomic write (see src/services/blocks.ts): the
      // block must exist AFTER the write for this to be valid, so a bare
      // "delete someone's inbound follow" attempt with no accompanying
      // block is still denied. Block must be the reason.
      allow delete: if isSignedIn()
        && (
          resource.data.followerUid == request.auth.uid
          || (
            resource.data.followingUid == request.auth.uid
            && existsAfter(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + resource.data.followerUid))
          )
        );
    }

    // Shared by follow/like/comment/conversation creation below — a block
    // in EITHER direction between two uids blocks new interaction both
    // ways (see src/types/block.ts).
    function isNotBlockedEitherWay(uidA, uidB) {
      return !exists(/databases/$(database)/documents/blocks/$(uidA + '_' + uidB))
        && !exists(/databases/$(database)/documents/blocks/$(uidB + '_' + uidA));
    }

    function isValidFollowCreate(followId, data) {
      return data.followerUid == request.auth.uid
        && data.followingUid != request.auth.uid
        && followId == data.followerUid + '_' + data.followingUid
        && exists(/databases/$(database)/documents/publicProfiles/$(data.followingUid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && isNotBlockedEitherWay(data.followerUid, data.followingUid)
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly(['followerUid', 'followingUid', 'createdAt']);
    }

    // reposts/{repostId} — Step 41.2F. PUBLIC repost relationships: a user
    // publicly republishing another account's Post (video or legacy text)
    // onto their own Profile's Reposts tab. Deliberately a public ROOT
    // collection (not users/{uid}/reposts) — a public Profile must be able
    // to query "everything this uid has reposted" without touching anyone's
    // private users/{uid} subtree. NEVER confuse this with the private
    // Saved relationships in users/{uid}/saved (Step 41.2E) — Saved stays
    // exactly as private as it already was; this is a separate,
    // intentionally public collection with a different read policy.
    match /reposts/{repostId} {
      // Same public-social read policy as follows/{followId} above — a
      // Repost is, by definition, something its owner chose to show on
      // their public Profile, so any signed-in user may read it.
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isValidRepostCreate(repostId, request.resource.data);

      allow update: if false;

      // Only the reposting user can ever remove their own Repost — never
      // the original author, never anyone else.
      allow delete: if isOwner(resource.data.userUid);
    }

    function repostReelTarget(targetId) {
      return get(/databases/$(database)/documents/reels/$(targetId)).data;
    }

    function repostContentTarget(targetId) {
      return get(/databases/$(database)/documents/content/$(targetId)).data;
    }

    // Rejects: a missing target, an unpublished/draft Reel, a non-'post'
    // legacy content document (Event, Activity), an unpublished legacy
    // Post, reposting your own Post either way (data.targetAuthorUid !=
    // request.auth.uid, combined with targetAuthorUid being verified below
    // to equal the target's REAL authorUid, together rule out both a
    // directly-spoofed self-repost and a spoofed targetAuthorUid that would
    // otherwise let someone launder around that check), and a malformed/
    // mismatched targetType or repostId.
    function isValidRepostCreate(repostId, data) {
      return data.userUid == request.auth.uid
        && data.targetType is string
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetAuthorUid is string
        && data.targetAuthorUid != request.auth.uid
        && repostId == (data.userUid + '_' + data.targetType + '_' + data.targetId)
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly(['userUid', 'targetType', 'targetId', 'targetAuthorUid', 'createdAt'])
        && (
          (data.targetType == 'reel'
            && exists(/databases/$(database)/documents/reels/$(data.targetId))
            && repostReelTarget(data.targetId).status == 'published'
            && repostReelTarget(data.targetId).authorUid == data.targetAuthorUid)
          || (data.targetType == 'post'
            && exists(/databases/$(database)/documents/content/$(data.targetId))
            && repostContentTarget(data.targetId).type == 'post'
            && repostContentTarget(data.targetId).status == 'published'
            && repostContentTarget(data.targetId).authorUid == data.targetAuthorUid)
        );
    }

    // postLikes/{likeId} — Step 41.2H.1. The authoritative, NORMALIZED
    // relationship behind Profile's future "Liked" stat: exactly one
    // non-self Like on one current, published, original social Post
    // (video Post or legacy text Post — never Event, never legacy
    // Activity). Unlike reposts/{repostId} (Step 41.2F), this is
    // deliberately NOT publicly readable, and not even owner-readable —
    // the app only ever needs the AGGREGATE COUNT of a profile's received
    // Likes, never a browsable list of who liked what, so there is no
    // reason to expose likerUid/targetAuthorUid/targetId/targetType as an
    // enumerable relationship graph. Reading the count itself is a later
    // step (41.2H.3+); this step is data model + write consistency only.
    match /postLikes/{likeId} {
      allow read: if false;

      allow create: if isSignedIn() && isValidPostLikeCreate(likeId, request.resource.data);

      allow update: if false;

      // Symmetric with the create-side pairing below: a postLikes row may
      // only be removed in the SAME atomic write that also removes the
      // real per-target Like it represents. The `!exists(...)` branch
      // (checked against THIS document's own path, never dereferencing
      // `resource.data`) makes deleting an ALREADY-ABSENT postLikes row an
      // unconditional no-op — required so the client's unlike batch can
      // always include this delete unconditionally (self-Likes and any
      // pre-migration Like created before this Rules change never had a
      // paired row to begin with) without ever crashing this rule on a
      // null `resource`.
      allow delete: if !exists(/databases/$(database)/documents/postLikes/$(likeId))
        || (isOwner(resource.data.likerUid) && isValidPostLikeDelete(resource.data));
    }

    function postLikeReelTarget(targetId) {
      return get(/databases/$(database)/documents/reels/$(targetId)).data;
    }

    function postLikeContentTarget(targetId) {
      return get(/databases/$(database)/documents/content/$(targetId)).data;
    }

    // Rejects: a missing target, an unpublished/draft Reel, a non-'post'
    // legacy content document (Event, Activity), an unpublished legacy
    // Post, a self-Like either way (data.targetAuthorUid !=
    // request.auth.uid, combined with targetAuthorUid being verified below
    // to equal the target's REAL authorUid — same anti-spoof pairing
    // already proven for reposts' isValidRepostCreate), a malformed/
    // mismatched targetType or likeId, and — critically — any write that
    // isn't happening in the SAME atomic batch as the real per-target
    // Like: existsAfter() below requires that Like to already be present
    // in the proposed post-write state, exactly the idiom this file
    // already uses to pair a Like with its notification (see
    // isValidNotificationDelete's existsAfter() checks), one hop further.
    function isValidPostLikeCreate(likeId, data) {
      return data.likerUid == request.auth.uid
        && data.targetType is string
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetAuthorUid is string
        && data.targetAuthorUid != request.auth.uid
        && likeId == (data.likerUid + '_' + data.targetType + '_' + data.targetId)
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly(['likerUid', 'targetAuthorUid', 'targetType', 'targetId', 'createdAt'])
        && (
          (data.targetType == 'reel'
            && exists(/databases/$(database)/documents/reels/$(data.targetId))
            && postLikeReelTarget(data.targetId).status == 'published'
            && postLikeReelTarget(data.targetId).authorUid == data.targetAuthorUid
            && existsAfter(/databases/$(database)/documents/reels/$(data.targetId)/likes/$(request.auth.uid)))
          || (data.targetType == 'post'
            && exists(/databases/$(database)/documents/content/$(data.targetId))
            && postLikeContentTarget(data.targetId).type == 'post'
            && postLikeContentTarget(data.targetId).status == 'published'
            && postLikeContentTarget(data.targetId).authorUid == data.targetAuthorUid
            && existsAfter(/databases/$(database)/documents/content/$(data.targetId)/likes/$(request.auth.uid)))
        );
    }

    // The reverse pairing: a postLikes row may only be deleted in the same
    // write that also removes the real per-target Like — never leaving a
    // phantom relationship behind. (A live Like with no postLikes row is
    // the harmless direction — it just undercounts until the next
    // like/unlike; the dangerous direction, a postLikes row surviving with
    // no real Like behind it, is the one this function makes impossible.)
    function isValidPostLikeDelete(data) {
      return (data.targetType == 'reel' && !existsAfter(/databases/$(database)/documents/reels/$(data.targetId)/likes/$(data.likerUid)))
        || (data.targetType == 'post' && !existsAfter(/databases/$(database)/documents/content/$(data.targetId)/likes/$(data.likerUid)));
    }

    // places/{placeId} — real public physical locations (see
    // src/types/place.ts). Ordinary users can only READ active Places.
    // Step 13 has no place-creation UI at all — Places are seeded only by
    // trusted tooling using the same `firebase login` CLI session as the
    // rest of this project's scripts (see scripts/delete-test-documents.cjs
    // for the equivalent pattern), never by ordinary client writes. This is
    // deliberate: unrestricted client writes would let anyone add fake
    // restaurants/venues to the public map. Business accounts, place
    // claiming, and user submissions are future steps, not this one.
    match /places/{placeId} {
      allow read: if isSignedIn() && resource.data.status == 'active';

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // content/{contentId} — the unified root collection for posts,
    // activities, and events (see src/types/content.ts). Every document's
    // author/city fields are validated against the author's own private
    // users/{uid} profile below, so a modified client can never impersonate
    // another user or another city — without making users/{uid} itself
    // publicly readable.
    match /content/{contentId} {
      // Base field set shared by every content type. placeId is always
      // present (a string places/{placeId} or null) — see isValidPlaceLink.
      function baseContentKeys() {
        return [
          'contentId', 'type', 'authorUid', 'authorDisplayName', 'authorUsername',
          'cityName', 'countryCode', 'cityKey', 'categoryId', 'placeId',
          'status', 'visibility', 'createdAt', 'updatedAt'
        ];
      }

      function isValidPostShape(data) {
        return data.type == 'post'
          && data.body is string
          && data.body.size() > 0
          && data.body.size() <= 1000
          && data.keys().hasAll(baseContentKeys().concat(['body']))
          && data.keys().hasOnly(baseContentKeys().concat(['body', 'placeName']))
          && (!('placeName' in data) || (data.placeName is string && data.placeName.size() <= 200));
      }

      function isValidActivityShape(data) {
        return data.type == 'activity'
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
          && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 200
          && data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.startsAt < data.endsAt
          && data.keys().hasAll(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName']))
          && data.keys().hasOnly(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName', 'maxParticipants']))
          && (!('maxParticipants' in data) || (data.maxParticipants is int && data.maxParticipants > 0 && data.maxParticipants <= 500));
      }

      function isValidEventShape(data) {
        return data.type == 'event'
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
          && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 200
          && data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.startsAt < data.endsAt
          // Step 12D — every "#token" this Event's own description
          // contains, normalized — see src/utils/hashtags.ts's
          // extractHashtags, the single source of truth for what a
          // hashtag actually is, and REQUIRED (not optional) here the
          // same way reels/{reelId}'s own isValidReelCreate already
          // requires `hashtags` on every new Reel (every NEW Event going
          // forward always supplies it, even as `[]` — only documents
          // that predate this step lack it at all, and this rule only
          // ever gates a CREATE, never a read of an old doc). Same
          // bound (<= 30) as Reels, same "bound the SHAPE, not re-parse
          // the text char-by-char" scope Reel's own rule already limits
          // itself to.
          && data.hashtags is list
          && data.hashtags.size() <= 30
          && data.keys().hasAll(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName', 'hashtags']))
          // Step 36 — coverPhotoURL is OPTIONAL (an organizer may skip it),
          // same "absent key, not a blank value" pattern isValidPostShape
          // already uses for placeName above.
          && data.keys().hasOnly(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName', 'hashtags', 'coverPhotoURL']))
          && (!('coverPhotoURL' in data) || (data.coverPhotoURL is string && data.coverPhotoURL.size() > 0 && data.coverPhotoURL.size() <= 2048));
      }

      // If placeId is set, the linked place must exist, be active, be in
      // the SAME city as this content, and content.placeName must exactly
      // match the place's real name — otherwise a modified client could
      // link Karlstad content to a Stockholm place, or attach a spoofed
      // placeName to a real place. exists() is checked before any get()
      // on the same path, so a nonexistent/mistyped placeId is denied
      // rather than causing get() to fail the whole rule evaluation.
      function isValidPlaceLink(data) {
        return data.placeId == null
          || (
            data.placeId is string
            && data.placeId.size() > 0
            && exists(/databases/$(database)/documents/places/$(data.placeId))
            && get(/databases/$(database)/documents/places/$(data.placeId)).data.status == 'active'
            && get(/databases/$(database)/documents/places/$(data.placeId)).data.cityKey == data.cityKey
            && get(/databases/$(database)/documents/places/$(data.placeId)).data.name == data.placeName
          );
      }

      // Fetches the caller's own private profile once (Firestore rules
      // cache repeated get()/exists() calls to the same path within one
      // evaluation, so this costs a single read regardless of how many
      // times `profile` is referenced below) and checks the full author +
      // city snapshot on the incoming document against it.
      function isValidContentCreate(data) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && profile.onboardingCompleted == true
          && data.contentId == contentId
          && data.authorUid == request.auth.uid
          && data.authorDisplayName == profile.displayName
          && data.authorUsername == profile.username
          && data.cityName == profile.cityName
          && data.countryCode == profile.countryCode
          && data.cityKey == profile.cityKey
          && data.status == 'published'
          && data.visibility == 'city'
          && data.categoryId is string
          && data.categoryId.size() > 0
          && isValidPlaceLink(data)
          && isServerTimestamp(data.createdAt)
          && isServerTimestamp(data.updatedAt)
          // Step 30 core rule: Business = Personal + the ability to create
          // Events. The accountType check below uses the exact same cached
          // `profile` this function already read once above (no extra
          // get()) — a Personal account fails this whole `&&` chain and is
          // denied; every other Event validation (author/city snapshot,
          // place link, shape) still applies in full.
          //
          // Step 41.2B.1: isValidActivityShape is deliberately no longer
          // referenced here — the legacy Activity content type is retired
          // from creation everywhere, client and server alike. The
          // function itself is left defined and untouched (not deleted)
          // since it documents the shape of documents that may still
          // exist; only the create policy changed. Existing
          // type == 'activity' documents are entirely unaffected — this
          // rule only gates NEW document creation, never reads, updates,
          // or the trusted Admin-SDK deletion paths.
          //
          // Step 41.2C.1: isValidPostShape is, by the identical reasoning,
          // now also no longer referenced here — the legacy text-only Post
          // content type is retired from creation everywhere now that the
          // user-facing Post product is video-first (reels/{reelId}, see
          // Step 41.2C). The function itself is left defined and untouched
          // (not deleted) since it documents the shape of documents that
          // may still exist; only the create policy changed. Existing
          // type == 'post' documents are entirely unaffected — this rule
          // only gates NEW document creation, never reads, updates, or the
          // trusted Admin-SDK deletion paths. content/{contentId} client
          // creation is now Event-only.
          && isValidEventShape(data) && profile.accountType == 'business';
      }

      // Published content is readable by any signed-in user (this also
      // governs list/query results — Firestore evaluates this per matched
      // document). Not scoped to the reader's own city: browsing other
      // cities is part of the product.
      allow read: if isSignedIn() && resource.data.status == 'published';

      allow create: if isSignedIn() && isValidContentCreate(request.resource.data);

      // No edit UI exists yet, so there's nothing to validate "which
      // fields are safely mutable" against — deny entirely for now rather
      // than design that validation speculatively. Revisit when an actual
      // edit flow exists.
      allow update: if false;

      // Disabled as of Step 10: content now has five possible subcollections
      // (participants, stats, responses, likes, comments) and Firestore
      // never cascade-deletes them when the parent document is removed.
      // There is no safe production cascade-delete workflow yet (and no
      // client "delete content" UI), so allowing a client to delete the
      // parent alone would leave those subcollections permanently orphaned.
      // Revisit once a real delete flow (Cloud Function or equivalent) exists.
      allow delete: if false;

      // content/{contentId}/participants/{uid} — one document per user who
      // joined an Activity. Paired 1:1 with a content/{contentId}/stats/activity
      // increment/decrement in the same atomic write (see below): a
      // participant document can never be created or deleted without the
      // matching counter change actually landing, and vice versa.
      match /participants/{uid} {
        function participantParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        allow read: if isSignedIn()
          && participantParent().type == 'activity'
          && participantParent().status == 'published';

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && isValidParticipantCreate(contentId, request.resource.data);

        // No edit surface for participation — you're either joined or not.
        allow update: if false;

        // A lone delete (no paired stats write in the same batch) would
        // otherwise pass an "existsAfter" check trivially — the stats doc is
        // untouched, so it still exists. We must verify its VALUE actually
        // decremented by exactly 1, which forces the client to include a
        // correctly-computed stats write in the same transaction.
        allow delete: if isOwner(uid)
          && existsAfter(/databases/$(database)/documents/content/$(contentId)/stats/activity)
          && getAfter(/databases/$(database)/documents/content/$(contentId)/stats/activity).data.participantCount
             == get(/databases/$(database)/documents/content/$(contentId)/stats/activity).data.participantCount - 1;
      }

      function isValidParticipantCreate(contentId, data) {
        let activity = get(/databases/$(database)/documents/content/$(contentId)).data;
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let statsPath = /databases/$(database)/documents/content/$(contentId)/stats/activity;
        return activity.type == 'activity'
          && activity.status == 'published'
          && activity.endsAt > request.time
          && data.uid == request.auth.uid
          && data.displayName == profile.displayName
          && data.username == profile.username
          && isServerTimestamp(data.joinedAt)
          && data.keys().hasOnly(['uid', 'displayName', 'username', 'joinedAt'])
          // The paired counter write must land in the same batch/transaction,
          // and must be exactly the correctly-incremented value — same
          // reasoning as the delete rule above (existence alone isn't enough).
          && existsAfter(statsPath)
          && getAfter(statsPath).data.participantCount == (exists(statsPath) ? get(statsPath).data.participantCount + 1 : 1);
      }

      // content/{contentId}/stats/activity — a single document holding the
      // live participant count, since maxParticipants needs a value that's
      // safe under concurrent joins without reading every participant.
      // Every increment/decrement must be exactly 1 and paired with the
      // caller's own participant document actually appearing/disappearing —
      // a client can never simply write participantCount directly.
      match /stats/activity {
        function statsParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        function isValidStatsShape(data) {
          return data.participantCount is int
            && data.participantCount >= 0
            && isServerTimestamp(data.updatedAt)
            && data.keys().hasOnly(['participantCount', 'updatedAt']);
        }

        function participantPath() {
          return /databases/$(database)/documents/content/$(contentId)/participants/$(request.auth.uid);
        }

        allow read: if isSignedIn()
          && statsParent().type == 'activity'
          && statsParent().status == 'published';

        // First join ever for this Activity — the stats doc doesn't exist yet.
        allow create: if isSignedIn()
          && isValidStatsShape(request.resource.data)
          && request.resource.data.participantCount == 1
          && !exists(participantPath())
          && existsAfter(participantPath())
          && (!('maxParticipants' in statsParent()) || 1 <= statsParent().maxParticipants);

        // Every later join (+1) or leave (-1) for this Activity.
        allow update: if isSignedIn()
          && isValidStatsShape(request.resource.data)
          && (
            (
              !exists(participantPath())
              && existsAfter(participantPath())
              && request.resource.data.participantCount == resource.data.participantCount + 1
              && (!('maxParticipants' in statsParent()) || request.resource.data.participantCount <= statsParent().maxParticipants)
            )
            || (
              exists(participantPath())
              && !existsAfter(participantPath())
              && request.resource.data.participantCount == resource.data.participantCount - 1
            )
          );

        allow delete: if false;
      }

      // Recommendation Engine — Step 4 — content/{contentId}/stats/engagement:
      // the trusted, server-aggregated engagement stats doc (see
      // src/types/engagementStats.ts and functions/src/engagementStats.ts).
      // Readable by any signed-in user viewing the content (same visibility
      // as the content itself) — but NEVER client-writable, in either
      // direction: only the Cloud Functions trigger (Admin SDK, which
      // bypasses these Rules entirely via IAM) may create/update/delete it.
      // This is the one thing that makes the stats trustworthy at all — see
      // this feature's own final report for why a client-writable aggregate
      // (even a "validated" one, like stats/activity above) can never be
      // more than self-reported.
      match /stats/engagement {
        function engagementStatsParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        allow read: if isSignedIn() && engagementStatsParent().status == 'published';

        allow create, update, delete: if false;
      }

      // content/{contentId}/responses/{uid} — one document per user's
      // Interested/Going response to an Event. Switching state updates this
      // same document; there is deliberately no separate counter here (Step
      // 9 uses aggregation count queries instead — see src/services/engagement.ts).
      match /responses/{uid} {
        function responseParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        allow read: if isSignedIn()
          && responseParent().type == 'event'
          && responseParent().status == 'published';

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && isValidResponseCreate(contentId, request.resource.data);

        allow update: if isOwner(uid)
          && isValidResponseUpdate(contentId, request.resource.data, resource.data);

        allow delete: if isOwner(uid);
      }

      function isValidResponseCreate(contentId, data) {
        let event = get(/databases/$(database)/documents/content/$(contentId)).data;
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return event.type == 'event'
          && event.status == 'published'
          && event.endsAt > request.time
          && data.uid == request.auth.uid
          && data.displayName == profile.displayName
          && data.username == profile.username
          && (data.status == 'interested' || data.status == 'going')
          && isServerTimestamp(data.createdAt)
          && isServerTimestamp(data.updatedAt)
          && data.keys().hasOnly(['uid', 'displayName', 'username', 'status', 'createdAt', 'updatedAt']);
      }

      function isValidResponseUpdate(contentId, newData, oldData) {
        let event = get(/databases/$(database)/documents/content/$(contentId)).data;
        return event.type == 'event'
          && event.endsAt > request.time
          && (newData.status == 'interested' || newData.status == 'going')
          && newData.uid == oldData.uid
          && newData.displayName == oldData.displayName
          && newData.username == oldData.username
          && newData.createdAt == oldData.createdAt
          && isServerTimestamp(newData.updatedAt)
          && newData.keys().hasOnly(['uid', 'displayName', 'username', 'status', 'createdAt', 'updatedAt']);
      }

      // content/{contentId}/likes/{uid} — one document per user who liked
      // this Post/Activity/Event, keyed by the liker's own uid (which is
      // itself what guarantees at most one Like per user — no separate
      // uniqueness check needed). No counter to keep paired: like counts
      // come from a getCountFromServer() aggregation query instead (see
      // src/services/socialEngagement.ts).
      match /likes/{uid} {
        function likeParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        allow read: if isSignedIn() && likeParent().status == 'published';

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && likeParent().status == 'published'
          && isNotBlockedEitherWay(request.auth.uid, likeParent().authorUid)
          && request.resource.data.uid == request.auth.uid
          && isServerTimestamp(request.resource.data.createdAt)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          // Step 41.2H.1 — a non-self Like on an original social Post
          // (type=='post' only; Event/Activity Likes are completely
          // unaffected) must land atomically with its postLikes
          // relationship. existsAfter() mirrors the exact pairing this
          // file already uses for Like+notification, one hop further.
          && (
            likeParent().type != 'post'
            || likeParent().authorUid == request.auth.uid
            || existsAfter(/databases/$(database)/documents/postLikes/$(request.auth.uid + '_post_' + contentId))
          );

        // Re-liking an existing Like doc is an update, not a create — denying
        // update here is what actually prevents a duplicate/overwritten Like,
        // not a separate "already exists" check on create.
        allow update: if false;

        // Step 41.2H.1 — symmetric with the create-side pairing: unliking
        // a non-self social Post must remove its postLikes relationship
        // in the same write. The `!exists(parent)` branch guards against
        // calling likeParent() on an already-deleted content document —
        // if the parent is gone, unlike is unconditionally allowed
        // (never traps a stale Like, same philosophy as the existing
        // block-tolerant behavior below).
        allow delete: if isOwner(uid)
          && (
            !exists(/databases/$(database)/documents/content/$(contentId))
            || likeParent().type != 'post'
            || likeParent().authorUid == uid
            || !existsAfter(/databases/$(database)/documents/postLikes/$(uid + '_post_' + contentId))
          );
      }

      // content/{contentId}/comments/{commentId} — top-level comments only
      // for Step 10 (no replies/threads). authorDisplayName/authorUsername
      // are a public-safe snapshot of the commenter's own profile, verified
      // against it below — same pattern as content authorship itself.
      match /comments/{commentId} {
        function commentParentPublished() {
          return get(/databases/$(database)/documents/content/$(contentId)).data.status == 'published';
        }

        allow read: if isSignedIn() && commentParentPublished();

        allow create: if isSignedIn() && isValidCommentCreate(contentId, commentId, request.resource.data);

        // Comment editing is a later step.
        allow update: if false;

        // Only the author — not the content's author — can delete a
        // comment for now. Moderation-by-content-author comes later.
        allow delete: if isOwner(resource.data.authorUid);
      }

      function isValidCommentCreate(contentId, commentId, data) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let contentAuthorUid = get(/databases/$(database)/documents/content/$(contentId)).data.authorUid;
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && profile.onboardingCompleted == true
          && get(/databases/$(database)/documents/content/$(contentId)).data.status == 'published'
          && isNotBlockedEitherWay(request.auth.uid, contentAuthorUid)
          && data.commentId == commentId
          && data.authorUid == request.auth.uid
          && data.authorDisplayName == profile.displayName
          && data.authorUsername == profile.username
          && data.body is string
          && data.body.size() > 0
          && data.body.size() <= 500
          && isServerTimestamp(data.createdAt)
          && isServerTimestamp(data.updatedAt)
          && data.keys().hasOnly(['commentId', 'authorUid', 'authorDisplayName', 'authorUsername', 'body', 'createdAt', 'updatedAt']);
      }
    }

    // reels/{reelId} — a separate root collection from content/{contentId}
    // (see src/types/reel.ts for why Reels don't share the content model).
    // Two-phase lifecycle: "uploading" -> "published" (see
    // src/services/reels.ts). Author/city fields are validated against the
    // author's own private users/{uid} profile, exactly like content
    // above. storagePath must exactly equal the deterministic path
    // reels/{authorUid}/{reelId}/source — independently re-verified by
    // storage.rules itself via its own cross-service firestore.get() call
    // (see storage.rules's file header for the IAM setup that makes that
    // possible), not just here.
    match /reels/{reelId} {
      // Published Reels are readable by any signed-in user (city feed
      // queries always filter status == 'published', so an in-progress
      // upload never appears there). An "uploading" draft is only
      // readable by its own author — needed for the upload workflow
      // (checking status, retrying, discarding) — nobody else can see an
      // unfinished Reel.
      allow read: if isSignedIn()
        && (resource.data.status == 'published' || resource.data.authorUid == request.auth.uid);

      allow create: if isSignedIn() && isValidReelCreate(reelId, request.resource.data);

      // Five allowed updates, and only these: uploading -> published
      // (the original, still overwhelmingly common case), Step 5E's
      // narrow, one-time "thumbnail moved to R2" flip, Step 9A/9B's
      // equally narrow, one-time "video source moved to R2" flip, Step
      // 9C's own lockstep "photo source+thumbnail moved to R2 together"
      // flip, and Step 10B's own narrow, one-time "music moved to R2"
      // flip — all only while still "uploading" — see
      // isValidReelPublish/isValidReelThumbnailProviderUpdate/
      // isValidReelSourceProviderUpdate/isValidReelPhotoSourceProviderUpdate/
      // isValidReelMusicProviderUpdate's own doc comments for the full
      // "every other field is immutable" reasoning each one separately
      // enforces (including each other's own provider fields — a client
      // can never piggyback a source-provider change through the
      // thumbnail-update rule, or a music-provider change through any of
      // the others, or vice versa).
      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && (
          isValidReelPublish(request.resource.data, resource.data)
          || isValidReelThumbnailProviderUpdate(request.resource.data, resource.data)
          || isValidReelSourceProviderUpdate(request.resource.data, resource.data)
          || isValidReelPhotoSourceProviderUpdate(request.resource.data, resource.data)
          || isValidReelMusicProviderUpdate(request.resource.data, resource.data)
        );

      // Only a still-uploading draft may be deleted, by its own author —
      // for failed/cancelled-upload cleanup (see discardReelDraft). A
      // published Reel can never be deleted by a client: there is no
      // trusted media + Firestore cascade-deletion workflow yet.
      allow delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && resource.data.status == 'uploading';

      // reels/{reelId}/likes/{uid} — one document per user who liked this
      // Reel, keyed by the liker's own uid (same uniqueness guarantee as
      // content/{contentId}/likes/{uid} — see isValidUserReport's sibling
      // pattern above). Structurally parallel to content Likes but kept
      // under reels/ since Reels are a separate root collection (see
      // src/types/reel.ts). No counter: like counts come from a
      // getCountFromServer() aggregation query (see
      // src/services/reelEngagement.ts), same as content Likes.
      match /likes/{uid} {
        function reelLikeParent() {
          return get(/databases/$(database)/documents/reels/$(reelId)).data;
        }

        allow read: if isSignedIn() && reelLikeParent().status == 'published';

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && reelLikeParent().status == 'published'
          && isNotBlockedEitherWay(request.auth.uid, reelLikeParent().authorUid)
          && request.resource.data.uid == request.auth.uid
          && isServerTimestamp(request.resource.data.createdAt)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          // Step 41.2H.1 — same pairing as content Likes, one hop simpler
          // since every Reel is inherently a social Post (no Event/
          // Activity equivalent exists for Reels) — only a self-Like is
          // exempt.
          && (
            reelLikeParent().authorUid == request.auth.uid
            || existsAfter(/databases/$(database)/documents/postLikes/$(request.auth.uid + '_reel_' + reelId))
          );

        // Re-liking an existing Like doc is an update, not a create — same
        // reasoning as content Likes: denying update is what actually
        // prevents a duplicate/overwritten Like.
        allow update: if false;

        // Only the Like's own owner may remove it — allowed even if a
        // Block was created after the Like, so unliking never traps a
        // stale Like (see the Step 19 spec's explicit requirement).
        // Step 41.2H.1 — symmetric postLikes pairing, same `!exists(parent)`
        // guard as content Likes above.
        allow delete: if isOwner(uid)
          && (
            !exists(/databases/$(database)/documents/reels/$(reelId))
            || reelLikeParent().authorUid == uid
            || !existsAfter(/databases/$(database)/documents/postLikes/$(uid + '_reel_' + reelId))
          );
      }

      // reels/{reelId}/comments/{commentId} — top-level comments only, no
      // replies/threads, no edit — structurally parallel to
      // content/{contentId}/comments/{commentId}.
      match /comments/{commentId} {
        function reelCommentParentPublished() {
          return get(/databases/$(database)/documents/reels/$(reelId)).data.status == 'published';
        }

        allow read: if isSignedIn() && reelCommentParentPublished();

        allow create: if isSignedIn() && isValidReelCommentCreate(reelId, commentId, request.resource.data);

        // Comment editing is not part of Step 19, same as content comments.
        allow update: if false;

        // The comment's own author may always delete it — allowed even if
        // a Block was created after the comment was posted. If this
        // document is itself a REPLY (parentCommentId != null), the
        // author of the comment it replies to may also delete it — this
        // is what lets deleteReelComment (src/services/reelEngagement.ts)
        // cascade-delete a top-level comment's own replies in the same
        // batch as deleting the comment itself, so a reply never survives
        // (orphaned, parentless) the comment it replied to.
        allow delete: if isOwner(resource.data.authorUid)
          || (
            // .get() with a default, not plain dot-notation — a comment
            // created before parentCommentId existed has no such key at
            // all, and must be treated as "not a reply" here, same
            // reasoning as this codebase's other legacy-field reads.
            resource.data.get('parentCommentId', null) != null
            && isOwner(get(/databases/$(database)/documents/reels/$(reelId)/comments/$(resource.data.get('parentCommentId', null))).data.authorUid)
          );

        // reels/{reelId}/comments/{commentId}/reactions/{uid} — one Like
        // or Dislike per user per comment (see ReelCommentReaction's own
        // doc comment in src/types/reel.ts for why this is exclusive/
        // single-doc rather than two subcollections, and why it's
        // deliberately unrelated to postLikes/lifetime Liked credit).
        match /reactions/{uid} {
          function reelCommentReactionExists() {
            return exists(/databases/$(database)/documents/reels/$(reelId)/comments/$(commentId));
          }

          allow read: if isSignedIn() && reelCommentParentPublished();

          // Both create (first reaction) and update (switching Like <->
          // Dislike, an overwrite of the same doc) need the identical
          // shape check — `set()` on an existing doc is evaluated as an
          // update, not a create, at the Rules level.
          allow create, update: if isSignedIn()
            && uid == request.auth.uid
            && reelCommentParentPublished()
            && reelCommentReactionExists()
            && request.resource.data.uid == request.auth.uid
            && (request.resource.data.type == 'like' || request.resource.data.type == 'dislike')
            && isServerTimestamp(request.resource.data.createdAt)
            && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt']);

          // Removing your own reaction (the "tap the same icon again to
          // undo" toggle) is always allowed — never trapped by a Block
          // created afterward, same reasoning as unliking a Reel. The
          // comment's own author may also remove ANY reaction on it — not
          // to moderate them individually, but because deleteReelComment
          // (src/services/reelEngagement.ts) batches this cleanup
          // together with the comment delete itself, so a reaction never
          // outlives the comment it was on.
          allow delete: if isOwner(uid)
            || (reelCommentReactionExists() && isOwner(get(/databases/$(database)/documents/reels/$(reelId)/comments/$(commentId)).data.authorUid));
        }
      }

      // Recommendation Engine — Step 4 — reels/{reelId}/stats/engagement:
      // same trusted, server-aggregated, never-client-writable stats doc as
      // content/{contentId}/stats/engagement above — see that block's own
      // doc comment for the full reasoning.
      match /stats/engagement {
        function reelEngagementStatsParent() {
          return get(/databases/$(database)/documents/reels/$(reelId)).data;
        }

        allow read: if isSignedIn() && reelEngagementStatsParent().status == 'published';

        allow create, update, delete: if false;
      }
    }

    // A reply's parentCommentId must reference a real comment on this
    // SAME Reel that is itself top-level (its own parentCommentId is
    // null) — caps replies at exactly one level, no reply-to-a-reply
    // chains (see ReelComment's own doc comment in src/types/reel.ts).
    function isValidReelCommentParent(reelId, data) {
      return data.parentCommentId == null
        || (
          data.parentCommentId is string
          && exists(/databases/$(database)/documents/reels/$(reelId)/comments/$(data.parentCommentId))
          // .get() with a default — see the comments' own delete rule for
          // why plain dot-notation is unsafe against a legacy comment
          // that predates this field entirely.
          && get(/databases/$(database)/documents/reels/$(reelId)/comments/$(data.parentCommentId)).data.get('parentCommentId', null) == null
        );
    }

    function isValidReelCommentCreate(reelId, commentId, data) {
      let reel = get(/databases/$(database)/documents/reels/$(reelId)).data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile.onboardingCompleted == true
        && reel.status == 'published'
        && isNotBlockedEitherWay(request.auth.uid, reel.authorUid)
        && data.commentId == commentId
        && data.authorUid == request.auth.uid
        && data.authorDisplayName == profile.displayName
        && data.authorUsername == profile.username
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 500
        && isValidReelCommentParent(reelId, data)
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly(['commentId', 'authorUid', 'authorDisplayName', 'authorUsername', 'body', 'parentCommentId', 'createdAt', 'updatedAt']);
    }

    function reelBaseKeys() {
      return [
        'reelId', 'authorUid', 'authorDisplayName', 'authorUsername',
        'cityName', 'countryCode', 'cityKey', 'categoryId', 'caption', 'hashtags',
        'mediaType', 'needsPhotoVideoRender', 'storagePath', 'storageContentType', 'fileSizeBytes', 'durationMs',
        'storageProvider', 'sourceUrl', 'sourceNormalized',
        'width', 'height', 'status', 'visibility',
        'musicSourceType', 'musicTitle', 'musicStorageAudioPath', 'musicStorageProvider',
        'musicStorageContentType', 'musicFileSizeBytes', 'musicDurationMs',
        'musicHash', 'soundOriginAuthorUid', 'soundOriginReelId',
        'thumbnailStoragePath', 'thumbnailStorageContentType',
        'thumbnailFileSizeBytes', 'thumbnailWidth', 'thumbnailHeight',
        'thumbnailStorageProvider', 'thumbnailUrl',
        'createdAt', 'updatedAt', 'publishedAt'
      ];
    }

    // A real still frame from the Reel's own video, chosen by the author
    // at capture time (see src/types/reel.ts's Reel.thumbnailStoragePath
    // doc comment) — REQUIRED on every Reel, unlike optional music. For a
    // "FOTO" mode Reel (mediaType == 'photo'), the photo already IS its
    // own cover — this instead requires thumbnailStoragePath to point at
    // the EXACT SAME object as storagePath, with identical metadata, since
    // there's no separate thumbnail object uploaded for one (see
    // isValidReelCreate below).
    function isValidReelThumbnail(reelId, authorUid, data) {
      return (
        data.mediaType == 'photo'
        && data.thumbnailStoragePath == data.storagePath
        && data.thumbnailStorageContentType == data.storageContentType
        && data.thumbnailFileSizeBytes == data.fileSizeBytes
        && data.thumbnailWidth == data.width
        && data.thumbnailHeight == data.height
      ) || (
        data.mediaType == 'video'
        && data.thumbnailStoragePath == 'reels/' + authorUid + '/' + reelId + '/thumbnail'
        && data.thumbnailStorageContentType is string
        && data.thumbnailStorageContentType.matches('image/.*')
        && data.thumbnailFileSizeBytes is int
        && data.thumbnailFileSizeBytes > 0
        && data.thumbnailFileSizeBytes <= 5242880
        && data.thumbnailWidth is number
        && data.thumbnailWidth > 0
        && data.thumbnailHeight is number
        && data.thumbnailHeight > 0
      );
    }

    // Device-picked background music (see src/types/reel.ts's
    // ReelMusicSourceType doc comment) — 'none' is the overwhelming
    // default; every music field is always present (never conditionally
    // omitted, same convention as every other Reel field), holding
    // empty-string/0 sentinels when unused. 'device' is the only real
    // source today — a future catalog source is an additive change here,
    // not a breaking one.
    function isValidReelMusic(reelId, authorUid, data) {
      return (
        data.musicSourceType == 'none'
        && data.musicTitle == ''
        && data.musicStorageAudioPath == ''
        && data.musicStorageContentType == ''
        && data.musicFileSizeBytes == 0
        && data.musicDurationMs == 0
      ) || (
        data.musicSourceType == 'device'
        && data.musicTitle is string
        && data.musicTitle.size() <= 200
        && data.musicStorageAudioPath == 'reels/' + authorUid + '/' + reelId + '/music'
        && data.musicStorageContentType is string
        && data.musicStorageContentType.matches('audio/.*')
        && data.musicFileSizeBytes is int
        && data.musicFileSizeBytes > 0
        && data.musicFileSizeBytes <= 20971520
        && data.musicDurationMs is int
        && data.musicDurationMs > 0
        && data.musicDurationMs <= 600000
      );
    }

    function isValidReelCreate(reelId, data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile.onboardingCompleted == true
        && data.reelId == reelId
        && data.authorUid == request.auth.uid
        && data.authorDisplayName == profile.displayName
        && data.authorUsername == profile.username
        && data.cityName == profile.cityName
        && data.countryCode == profile.countryCode
        && data.cityKey == profile.cityKey
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.caption is string
        && data.caption.size() <= 5000
        // Every "#token" this Reel's own caption contains, normalized —
        // see src/utils/hashtags.ts's extractHashtags, the single source
        // of truth for what a hashtag actually is. Deliberately NOT
        // re-parsed/re-validated against `data.caption` here char-by-char
        // (Firestore Rules has no practical way to run that same
        // Unicode-aware regex) — this only bounds the SHAPE (a real list
        // of reasonably-sized lowercase strings) against abuse, the same
        // scope firestore.rules already limits itself to for every other
        // client-declared value.
        && data.hashtags is list
        && data.hashtags.size() <= 30
        && data.mediaType in ['video', 'photo']
        && data.needsPhotoVideoRender is bool
        // Only a 'video' draft can ever be pending photo-to-video
        // rendering — see Reel.needsPhotoVideoRender's own doc comment in
        // src/types/reel.ts. A plain 'photo' (no music) is never in this
        // transient state.
        && (data.mediaType == 'video' || data.needsPhotoVideoRender == false)
        && data.storagePath == 'reels/' + request.auth.uid + '/' + reelId + '/source'
        // Step 9A — same "required field, fixed default at create"
        // pattern as thumbnailStorageProvider below, for the Reel's own
        // video source this time. Only a trusted, one-time
        // server-authorized update (see isValidReelSourceProviderUpdate
        // below) can ever flip this to 'r2' — a client can never create
        // a draft already claiming R2, regardless of mediaType/music.
        && data.storageProvider == 'firebase'
        && data.sourceUrl == ''
        // Step 11B — every draft is created not-yet-normalized, same
        // "required field, fixed default at create" pattern as
        // storageProvider above, applied uniformly regardless of
        // mediaType (a plain photo Reel never gets this flipped to true —
        // see isValidReelPublish below, which exempts photo Reels from
        // the gate entirely — but it still defaults the same way as
        // every other Reel field, never conditionally omitted). Only a
        // trusted Cloud Function (finalizeReelVideo/muxReelMusic/
        // renderPhotoToVideo, via the Admin SDK) can ever flip this to
        // true — there is no client-facing transition rule for it at
        // all, unlike storageProvider/musicStorageProvider, because no
        // client ever writes this field directly.
        && data.sourceNormalized == false
        && (
          (
            data.mediaType == 'video'
            && data.needsPhotoVideoRender == false
            && data.storageContentType is string
            && data.storageContentType.matches('video/.*')
            && data.fileSizeBytes is int
            && data.fileSizeBytes > 0
            && data.fileSizeBytes <= 52428800
            && data.durationMs is int
            && data.durationMs > 0
            && data.durationMs <= 60000
          ) || (
            // "FOTO" mode WITH music (Step — renderPhotoToVideo): mediaType
            // is already 'video', but the upload landing at storagePath
            // right now is still the photo itself, pending server-side
            // rendering — same image bounds as a plain photo below, except
            // durationMs is fixed at exactly 15000 (REEL_PHOTO_DURATION_MS
            // in src/types/reel.ts — this literal must stay in sync with
            // that constant) rather than the sentinel 0, since this Reel
            // WILL have a real 15-second duration once rendered.
            data.mediaType == 'video'
            && data.needsPhotoVideoRender == true
            // renderPhotoToVideo (functions/src/index.ts) refuses to run at
            // all without device-picked music — a "FOTO" capture with no
            // music never sets needsPhotoVideoRender in the first place
            // (it's a plain mediaType == 'photo' draft instead), so this
            // combination should never legitimately be missing music.
            && data.musicSourceType == 'device'
            && data.storageContentType is string
            && data.storageContentType.matches('image/.*')
            && data.fileSizeBytes is int
            && data.fileSizeBytes > 0
            && data.fileSizeBytes <= 10485760
            && data.durationMs == 15000
          ) || (
            data.mediaType == 'photo'
            && data.storageContentType is string
            && data.storageContentType.matches('image/.*')
            && data.fileSizeBytes is int
            && data.fileSizeBytes > 0
            && data.fileSizeBytes <= 10485760
            // A photo has no duration — always the sentinel 0, same
            // convention as every other unused-for-this-variant field.
            && data.durationMs == 0
          )
        )
        && data.width is number
        && data.width > 0
        && data.height is number
        && data.height > 0
        && data.status == 'uploading'
        && data.visibility == 'city'
        && data.publishedAt == null
        // Sound attribution (musicHash/soundOriginAuthorUid/
        // soundOriginReelId — see Reel.musicHash's own doc comment in
        // src/types/reel.ts) is NEVER known at create time — only a
        // trusted Cloud Function computes it, later, via an Admin SDK
        // update that bypasses these Rules entirely. A client can only
        // ever create a draft with these still empty.
        && data.musicHash == ''
        && data.soundOriginAuthorUid == ''
        && data.soundOriginReelId == ''
        // Step 5E — a draft is always created with its thumbnail still on
        // Firebase, same "required field, fixed default at create" pattern
        // as musicHash/soundOriginAuthorUid/soundOriginReelId above. Only a
        // trusted, one-time server-authorized update (see
        // isValidReelThumbnailProviderUpdate below) can ever flip this to
        // 'r2' — a client can never create a draft already claiming R2.
        && data.thumbnailStorageProvider == 'firebase'
        && data.thumbnailUrl == ''
        // Step 10B — same "required field, fixed default at create"
        // pattern as storageProvider/thumbnailStorageProvider above, for
        // the Reel's own standalone music this time — ALWAYS present and
        // 'firebase', regardless of musicSourceType (same always-present
        // sentinel convention isValidReelMusic already applies to every
        // other music field). Only a trusted, one-time server-authorized
        // update (see isValidReelMusicProviderUpdate below) can ever flip
        // this to 'r2'.
        && data.musicStorageProvider == 'firebase'
        && isValidReelMusic(reelId, request.auth.uid, data)
        && isValidReelThumbnail(reelId, request.auth.uid, data)
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly(reelBaseKeys());
    }

    // Every field except status/publishedAt/updatedAt must stay
    // byte-identical to what create validated — this is what actually
    // enforces "no caption editing, no city changing, no storage path
    // changing, no author changing" from the Step 18 spec, not just the
    // status-transition check by itself. Music fields are equally
    // immutable once created — no swapping the track after publish.
    function isValidReelPublish(newData, oldData) {
      return oldData.status == 'uploading'
        && newData.status == 'published'
        && oldData.publishedAt == null
        && isServerTimestamp(newData.publishedAt)
        && isServerTimestamp(newData.updatedAt)
        && newData.reelId == oldData.reelId
        && newData.authorUid == oldData.authorUid
        && newData.authorDisplayName == oldData.authorDisplayName
        && newData.authorUsername == oldData.authorUsername
        && newData.cityName == oldData.cityName
        && newData.countryCode == oldData.countryCode
        && newData.cityKey == oldData.cityKey
        && newData.categoryId == oldData.categoryId
        && newData.caption == oldData.caption
        && newData.hashtags == oldData.hashtags
        && newData.mediaType == oldData.mediaType
        // A Reel still awaiting photo-to-video rendering (see
        // Reel.needsPhotoVideoRender's own doc comment) can never publish —
        // renderPhotoToVideo (an Admin SDK write, bypassing these Rules
        // entirely) must flip this to false FIRST, which is also the point
        // at which storagePath actually starts holding a real video instead
        // of the original photo. Without this check, a client could skip
        // straight to publishReel and publish the raw, un-rendered photo
        // as if it were a real video.
        && oldData.needsPhotoVideoRender == false
        && newData.needsPhotoVideoRender == false
        // Step 11B — a VIDEO Reel can never publish until its source has
        // actually been through one of the three finalization pipelines
        // (finalizeReelVideo/muxReelMusic/renderPhotoToVideo, all of
        // which stamp sourceNormalized: true in their own Admin-SDK
        // confirm-write, bypassing these Rules entirely — see each
        // function's own doc comment in functions/src/index.ts). A plain
        // PHOTO Reel is exempt: it is never transcoded at all (Part 9 of
        // the Step 11B spec), so it would otherwise be stuck at
        // sourceNormalized: false forever. This is a REAL server-enforced
        // invariant, not just client call-ordering discipline — a
        // modified or buggy client calling publishReel too early is
        // rejected here regardless of what it intended to do first.
        && (oldData.mediaType == 'photo' || oldData.sourceNormalized == true)
        && newData.sourceNormalized == oldData.sourceNormalized
        && newData.storagePath == oldData.storagePath
        && newData.storageContentType == oldData.storageContentType
        && newData.fileSizeBytes == oldData.fileSizeBytes
        && newData.storageProvider == oldData.storageProvider
        && newData.sourceUrl == oldData.sourceUrl
        && newData.durationMs == oldData.durationMs
        && newData.width == oldData.width
        && newData.height == oldData.height
        && newData.visibility == oldData.visibility
        && newData.musicSourceType == oldData.musicSourceType
        && newData.musicTitle == oldData.musicTitle
        && newData.musicStorageAudioPath == oldData.musicStorageAudioPath
        && newData.musicStorageProvider == oldData.musicStorageProvider
        && newData.musicStorageContentType == oldData.musicStorageContentType
        && newData.musicFileSizeBytes == oldData.musicFileSizeBytes
        && newData.musicDurationMs == oldData.musicDurationMs
        && newData.musicHash == oldData.musicHash
        && newData.soundOriginAuthorUid == oldData.soundOriginAuthorUid
        && newData.soundOriginReelId == oldData.soundOriginReelId
        && newData.thumbnailStoragePath == oldData.thumbnailStoragePath
        && newData.thumbnailStorageContentType == oldData.thumbnailStorageContentType
        && newData.thumbnailFileSizeBytes == oldData.thumbnailFileSizeBytes
        && newData.thumbnailWidth == oldData.thumbnailWidth
        && newData.thumbnailHeight == oldData.thumbnailHeight
        && newData.thumbnailStorageProvider == oldData.thumbnailStorageProvider
        && newData.thumbnailUrl == oldData.thumbnailUrl
        && newData.createdAt == oldData.createdAt
        && newData.keys().hasOnly(reelBaseKeys());
    }

    // Step 5E — the ONE other allowed update besides publish: a still-
    // "uploading" video Reel's thumbnail moving from Firebase to R2, once
    // (and only once) a direct client upload to R2 has actually succeeded
    // (see functions/src/media/requestMediaUploadAuthorization.ts's own
    // verifyReelThumbnailOwnership for the server-side authorization that
    // must happen BEFORE that upload, and src/services/reels.ts's
    // confirmReelThumbnailProvider, the only client-side caller of this
    // path). `oldData.thumbnailStorageProvider == 'firebase'` is what
    // makes this fire at most once ever per Reel — a second attempt to
    // call this against a Reel that's already 'r2' is always denied here,
    // exactly mirroring isValidReelPublish's own
    // `oldData.status == 'uploading'` one-shot guard above. Every field
    // besides thumbnailStorageProvider/thumbnailUrl/updatedAt must stay
    // byte-identical — same "no sneaking an unrelated change through this
    // narrow door" reasoning as isValidReelPublish.
    function isValidReelThumbnailProviderUpdate(newData, oldData) {
      return oldData.status == 'uploading'
        && newData.status == 'uploading'
        // Only a real video Reel has a separate thumbnail object to begin
        // with — a 'photo' Reel's thumbnail IS its own storagePath (see
        // isValidReelThumbnail above) and must never reach this path (also
        // independently enforced server-side, before any R2 upload is
        // even authorized — see verifyReelThumbnailOwnership).
        && oldData.mediaType == 'video'
        && newData.mediaType == 'video'
        && oldData.thumbnailStorageProvider == 'firebase'
        && newData.thumbnailStorageProvider == 'r2'
        && newData.thumbnailUrl is string
        && newData.thumbnailUrl.size() > 0
        && newData.thumbnailUrl.size() <= 2048
        && newData.thumbnailUrl.matches('https://.*')
        && isServerTimestamp(newData.updatedAt)
        && newData.reelId == oldData.reelId
        && newData.authorUid == oldData.authorUid
        && newData.authorDisplayName == oldData.authorDisplayName
        && newData.authorUsername == oldData.authorUsername
        && newData.cityName == oldData.cityName
        && newData.countryCode == oldData.countryCode
        && newData.cityKey == oldData.cityKey
        && newData.categoryId == oldData.categoryId
        && newData.caption == oldData.caption
        && newData.hashtags == oldData.hashtags
        && newData.needsPhotoVideoRender == oldData.needsPhotoVideoRender
        && newData.storagePath == oldData.storagePath
        && newData.storageContentType == oldData.storageContentType
        && newData.fileSizeBytes == oldData.fileSizeBytes
        // Step 9A — the video source's own provider/URL must stay
        // unchanged during a THUMBNAIL-only transition (see this
        // function's own doc comment on why the two are never coupled).
        // Without this, a client could piggyback a source-provider
        // change through this rule the moment both fields existed in the
        // schema, since hasOnly(reelBaseKeys()) alone permits the keys
        // without constraining their values.
        && newData.storageProvider == oldData.storageProvider
        && newData.sourceUrl == oldData.sourceUrl
        && newData.durationMs == oldData.durationMs
        && newData.width == oldData.width
        && newData.height == oldData.height
        && newData.visibility == oldData.visibility
        && newData.musicSourceType == oldData.musicSourceType
        && newData.musicTitle == oldData.musicTitle
        && newData.musicStorageAudioPath == oldData.musicStorageAudioPath
        && newData.musicStorageProvider == oldData.musicStorageProvider
        && newData.sourceNormalized == oldData.sourceNormalized
        && newData.musicStorageContentType == oldData.musicStorageContentType
        && newData.musicFileSizeBytes == oldData.musicFileSizeBytes
        && newData.musicDurationMs == oldData.musicDurationMs
        && newData.musicHash == oldData.musicHash
        && newData.soundOriginAuthorUid == oldData.soundOriginAuthorUid
        && newData.soundOriginReelId == oldData.soundOriginReelId
        && newData.thumbnailStoragePath == oldData.thumbnailStoragePath
        && newData.thumbnailStorageContentType == oldData.thumbnailStorageContentType
        && newData.thumbnailFileSizeBytes == oldData.thumbnailFileSizeBytes
        && newData.thumbnailWidth == oldData.thumbnailWidth
        && newData.thumbnailHeight == oldData.thumbnailHeight
        && newData.createdAt == oldData.createdAt
        && newData.publishedAt == oldData.publishedAt
        && newData.keys().hasOnly(reelBaseKeys());
    }

    // Step 9A/9B — the video-source counterpart to
    // isValidReelThumbnailProviderUpdate above: a still-"uploading" video
    // Reel's own source moving from Firebase to R2, once (and only once)
    // a direct client upload to R2 has actually succeeded (see
    // functions/src/media/requestMediaUploadAuthorization.ts's own
    // verifyReelVideoOwnership for the server-side authorization that
    // must happen BEFORE that upload, and src/services/reels.ts's
    // confirmReelVideoProvider, the only client-side caller of this
    // path). `oldData.storageProvider == 'firebase'` is what makes this
    // fire at most once ever per Reel, exactly mirroring
    // isValidReelThumbnailProviderUpdate's own one-shot guard.
    //
    // `oldData.musicSourceType == newData.musicSourceType` (unchanged
    // during THIS transition either way — music state itself never
    // changes here, only confirmed to already be an allowed value) plus
    // `oldData.needsPhotoVideoRender == newData.needsPhotoVideoRender`
    // (also required to stay unchanged, alongside every other field,
    // since only mediaType/status/storageProvider/sourceUrl are
    // permitted to differ at all) is DEFENSE IN DEPTH mirroring
    // checkReelVideoEligibility's own eligibility check — even though the
    // authorization callable already refuses to hand out a presigned URL
    // for an unsupported-music Reel, this rule independently refuses to
    // ever confirm one as 'r2' either, so a confirm-write alone (without
    // ever having passed authorization) could never move an ineligible
    // Reel's source off Firebase. Step 9B relaxed the ALLOWED music
    // values from `'none'`-only to `'none' or 'device'` — muxReelMusic
    // now knows how to read/replace this exact object on either backend
    // before publish (see reelMuxOrchestration.ts) — but a Reel with any
    // OTHER music state is still rejected here, same
    // allowlist-not-blocklist posture as the server-side eligibility
    // check it mirrors. Step 9C relaxed `needsPhotoVideoRender` from a
    // fixed `false` on both sides to "stays whatever it already was" —
    // `true` is now also allowed (a photo-pending-render Reel, already
    // separately gated by `mediaType == 'video'` below — see
    // checkReelVideoEligibility's own doc comment in
    // functions/src/media/reelEligibility.ts) since renderPhotoToVideo is
    // now provider-aware too (Step 9C) and can read/replace this exact
    // object on either backend before it runs; `false` (a plain video
    // Reel) is unaffected.
    function isValidReelSourceProviderUpdate(newData, oldData) {
      return oldData.status == 'uploading'
        && newData.status == 'uploading'
        && oldData.mediaType == 'video'
        && newData.mediaType == 'video'
        && (oldData.musicSourceType == 'none' || oldData.musicSourceType == 'device')
        && newData.musicSourceType == oldData.musicSourceType
        && newData.needsPhotoVideoRender == oldData.needsPhotoVideoRender
        && oldData.storageProvider == 'firebase'
        && newData.storageProvider == 'r2'
        && newData.sourceUrl is string
        && newData.sourceUrl.size() > 0
        && newData.sourceUrl.size() <= 2048
        && newData.sourceUrl.matches('https://.*')
        && isServerTimestamp(newData.updatedAt)
        && newData.reelId == oldData.reelId
        && newData.authorUid == oldData.authorUid
        && newData.authorDisplayName == oldData.authorDisplayName
        && newData.authorUsername == oldData.authorUsername
        && newData.cityName == oldData.cityName
        && newData.countryCode == oldData.countryCode
        && newData.cityKey == oldData.cityKey
        && newData.categoryId == oldData.categoryId
        && newData.caption == oldData.caption
        && newData.hashtags == oldData.hashtags
        && newData.storagePath == oldData.storagePath
        && newData.storageContentType == oldData.storageContentType
        && newData.fileSizeBytes == oldData.fileSizeBytes
        && newData.durationMs == oldData.durationMs
        && newData.width == oldData.width
        && newData.height == oldData.height
        && newData.visibility == oldData.visibility
        && newData.musicTitle == oldData.musicTitle
        && newData.musicStorageAudioPath == oldData.musicStorageAudioPath
        && newData.musicStorageProvider == oldData.musicStorageProvider
        && newData.sourceNormalized == oldData.sourceNormalized
        && newData.musicStorageContentType == oldData.musicStorageContentType
        && newData.musicFileSizeBytes == oldData.musicFileSizeBytes
        && newData.musicDurationMs == oldData.musicDurationMs
        && newData.musicHash == oldData.musicHash
        && newData.soundOriginAuthorUid == oldData.soundOriginAuthorUid
        && newData.soundOriginReelId == oldData.soundOriginReelId
        && newData.thumbnailStoragePath == oldData.thumbnailStoragePath
        && newData.thumbnailStorageContentType == oldData.thumbnailStorageContentType
        && newData.thumbnailFileSizeBytes == oldData.thumbnailFileSizeBytes
        && newData.thumbnailWidth == oldData.thumbnailWidth
        && newData.thumbnailHeight == oldData.thumbnailHeight
        // Step 9A — the thumbnail's own provider/URL must stay unchanged
        // during a SOURCE-only transition — same mutual-exclusion
        // reasoning as isValidReelThumbnailProviderUpdate's own new
        // storageProvider/sourceUrl equality checks above.
        && newData.thumbnailStorageProvider == oldData.thumbnailStorageProvider
        && newData.thumbnailUrl == oldData.thumbnailUrl
        && newData.createdAt == oldData.createdAt
        && newData.publishedAt == oldData.publishedAt
        && newData.keys().hasOnly(reelBaseKeys());
    }

    // Step 9C — the LOCKSTEP counterpart of isValidReelThumbnailProviderUpdate
    // and isValidReelSourceProviderUpdate above, for a PLAIN PHOTO Reel
    // only (`mediaType == 'photo'` on both sides). A photo Reel has no
    // separate thumbnail object at all — its source and thumbnail are the
    // exact same object (see isValidReelThumbnail's own doc comment) — so
    // unlike a video Reel, where the two provider pairs are deliberately
    // kept independent (see isValidReelSourceProviderUpdate's own doc
    // comment on why they're never coupled there), a photo Reel's
    // storageProvider/sourceUrl and thumbnailStorageProvider/thumbnailUrl
    // must transition TOGETHER, in one write, to the SAME url — otherwise
    // a client could confirm the source as 'r2' while the thumbnail pair
    // stayed stuck at its 'firebase' default forever (there is no
    // separate client upload step that would ever set it — see
    // src/services/reels.ts's confirmReelPhotoSourceProvider, the only
    // caller of this path). `oldData.storageProvider == 'firebase'` is
    // what makes this fire at most once ever per Reel, same one-shot
    // guard as the two functions above.
    function isValidReelPhotoSourceProviderUpdate(newData, oldData) {
      return oldData.status == 'uploading'
        && newData.status == 'uploading'
        && oldData.mediaType == 'photo'
        && newData.mediaType == 'photo'
        && oldData.storageProvider == 'firebase'
        && newData.storageProvider == 'r2'
        && oldData.thumbnailStorageProvider == 'firebase'
        && newData.thumbnailStorageProvider == 'r2'
        && newData.sourceUrl is string
        && newData.sourceUrl.size() > 0
        && newData.sourceUrl.size() <= 2048
        && newData.sourceUrl.matches('https://.*')
        // The defining constraint of this transition — see this
        // function's own doc comment: a photo Reel's source and
        // thumbnail are literally the same object, so their confirmed
        // delivery URLs must be identical too.
        && newData.thumbnailUrl == newData.sourceUrl
        && isServerTimestamp(newData.updatedAt)
        && newData.reelId == oldData.reelId
        && newData.authorUid == oldData.authorUid
        && newData.authorDisplayName == oldData.authorDisplayName
        && newData.authorUsername == oldData.authorUsername
        && newData.cityName == oldData.cityName
        && newData.countryCode == oldData.countryCode
        && newData.cityKey == oldData.cityKey
        && newData.categoryId == oldData.categoryId
        && newData.caption == oldData.caption
        && newData.hashtags == oldData.hashtags
        && newData.needsPhotoVideoRender == oldData.needsPhotoVideoRender
        && newData.storagePath == oldData.storagePath
        && newData.storageContentType == oldData.storageContentType
        && newData.fileSizeBytes == oldData.fileSizeBytes
        && newData.durationMs == oldData.durationMs
        && newData.width == oldData.width
        && newData.height == oldData.height
        && newData.visibility == oldData.visibility
        && newData.musicSourceType == oldData.musicSourceType
        && newData.musicTitle == oldData.musicTitle
        && newData.musicStorageAudioPath == oldData.musicStorageAudioPath
        && newData.musicStorageProvider == oldData.musicStorageProvider
        && newData.sourceNormalized == oldData.sourceNormalized
        && newData.musicStorageContentType == oldData.musicStorageContentType
        && newData.musicFileSizeBytes == oldData.musicFileSizeBytes
        && newData.musicDurationMs == oldData.musicDurationMs
        && newData.musicHash == oldData.musicHash
        && newData.soundOriginAuthorUid == oldData.soundOriginAuthorUid
        && newData.soundOriginReelId == oldData.soundOriginReelId
        && newData.thumbnailStoragePath == oldData.thumbnailStoragePath
        && newData.thumbnailStorageContentType == oldData.thumbnailStorageContentType
        && newData.thumbnailFileSizeBytes == oldData.thumbnailFileSizeBytes
        && newData.thumbnailWidth == oldData.thumbnailWidth
        && newData.thumbnailHeight == oldData.thumbnailHeight
        && newData.createdAt == oldData.createdAt
        && newData.publishedAt == oldData.publishedAt
        && newData.keys().hasOnly(reelBaseKeys());
    }

    // Step 10B — a still-"uploading" Reel's own standalone music moving
    // from Firebase to R2, once (and only once) a direct client upload to
    // R2 has actually succeeded (see
    // functions/src/media/requestMediaUploadAuthorization.ts's own
    // verifyReelMusicOwnership for the server-side authorization that
    // must happen BEFORE that upload, and src/services/reels.ts's
    // confirmReelMusicProvider, the only client-side caller of this
    // path). `oldData.musicStorageProvider == 'firebase'` is what makes
    // this fire at most once ever per Reel, exactly mirroring every other
    // provider-transition rule's own one-shot guard. Unlike the video
    // source/thumbnail transitions, there is NO url field to validate at
    // all — a Reel's music object has no public-URL concept (see
    // Reel.musicStorageProvider's own doc comment, src/types/reel.ts) —
    // making this the simplest of the four provider transitions.
    // `oldData.musicSourceType == 'device'` (required, not just an
    // unchanged-either-way check) mirrors checkReelMusicUploadEligibility's
    // own server-side gate — a no-music Reel could never legitimately
    // reach this transition in the first place.
    function isValidReelMusicProviderUpdate(newData, oldData) {
      return oldData.status == 'uploading'
        && newData.status == 'uploading'
        && oldData.musicSourceType == 'device'
        && newData.musicSourceType == 'device'
        && oldData.musicStorageProvider == 'firebase'
        && newData.musicStorageProvider == 'r2'
        && isServerTimestamp(newData.updatedAt)
        && newData.reelId == oldData.reelId
        && newData.authorUid == oldData.authorUid
        && newData.authorDisplayName == oldData.authorDisplayName
        && newData.authorUsername == oldData.authorUsername
        && newData.cityName == oldData.cityName
        && newData.countryCode == oldData.countryCode
        && newData.cityKey == oldData.cityKey
        && newData.categoryId == oldData.categoryId
        && newData.caption == oldData.caption
        && newData.hashtags == oldData.hashtags
        && newData.mediaType == oldData.mediaType
        && newData.needsPhotoVideoRender == oldData.needsPhotoVideoRender
        && newData.storagePath == oldData.storagePath
        && newData.storageContentType == oldData.storageContentType
        && newData.fileSizeBytes == oldData.fileSizeBytes
        && newData.storageProvider == oldData.storageProvider
        && newData.sourceUrl == oldData.sourceUrl
        && newData.sourceNormalized == oldData.sourceNormalized
        && newData.durationMs == oldData.durationMs
        && newData.width == oldData.width
        && newData.height == oldData.height
        && newData.visibility == oldData.visibility
        && newData.musicTitle == oldData.musicTitle
        && newData.musicStorageAudioPath == oldData.musicStorageAudioPath
        && newData.musicStorageContentType == oldData.musicStorageContentType
        && newData.musicFileSizeBytes == oldData.musicFileSizeBytes
        && newData.musicDurationMs == oldData.musicDurationMs
        && newData.musicHash == oldData.musicHash
        && newData.soundOriginAuthorUid == oldData.soundOriginAuthorUid
        && newData.soundOriginReelId == oldData.soundOriginReelId
        && newData.thumbnailStoragePath == oldData.thumbnailStoragePath
        && newData.thumbnailStorageContentType == oldData.thumbnailStorageContentType
        && newData.thumbnailFileSizeBytes == oldData.thumbnailFileSizeBytes
        && newData.thumbnailWidth == oldData.thumbnailWidth
        && newData.thumbnailHeight == oldData.thumbnailHeight
        && newData.thumbnailStorageProvider == oldData.thumbnailStorageProvider
        && newData.thumbnailUrl == oldData.thumbnailUrl
        && newData.createdAt == oldData.createdAt
        && newData.publishedAt == oldData.publishedAt
        && newData.keys().hasOnly(reelBaseKeys());
    }

    // hashtags/{hashtagId} — global counter per unique, normalized hashtag
    // (see src/types/hashtag.ts). `hashtagId` IS `name` — a client
    // publishing a Reel with hashtags creates/increments these directly
    // (see src/services/hashtags.ts's incrementHashtagCounts, called from
    // publishReel), exactly like the existing content/{contentId}/
    // stats/activity `participantCount` pattern above: a client may only
    // ever CREATE with postCount == 1, or INCREMENT an existing doc by
    // exactly 1 — never set an arbitrary value, and never decrement.
    // Decrementing (a post carrying this hashtag being deleted) is NEVER
    // client-writable at all — only the trusted Cloud Functions delete
    // backend (Admin SDK, bypassing these Rules — see
    // functions/src/index.ts's decrementHashtagCounts) can lower it,
    // same trust boundary as reels/{reelId}/stats/engagement above being
    // entirely non-client-writable in either direction.
    match /hashtags/{hashtagId} {
      function isValidHashtagShape(data) {
        return data.name is string
          && data.name == hashtagId
          && data.postCount is int
          && data.postCount >= 0
          && isServerTimestamp(data.updatedAt)
          && data.keys().hasOnly(['name', 'postCount', 'createdAt', 'updatedAt']);
      }

      allow read: if isSignedIn();

      // The first published Reel ever to use this exact hashtag.
      allow create: if isSignedIn()
        && isValidHashtagShape(request.resource.data)
        && request.resource.data.postCount == 1
        && isServerTimestamp(request.resource.data.createdAt);

      // Every later Reel publish (+1) adding this same hashtag.
      // `createdAt` must stay byte-identical — only a fresh document's
      // OWN create (above) may ever set it.
      allow update: if isSignedIn()
        && isValidHashtagShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.postCount == resource.data.postCount + 1;

      allow delete: if false;
    }

    // Trending Hashtags by City and Time Window —
    // cityHashtagTrends/{cityId}__{hashtag}: trusted, server-aggregated
    // per-(city,hashtag) recent activity (see
    // functions/src/hashtagTrends.ts). Deliberately GIVEN NO client write
    // path at all, unlike hashtags/{hashtagId} just above (which the
    // client DOES write via a constrained +1 transaction): every field
    // here (`recentPosts`/`recentEngagement` arrays, `lastActivityAt`) is
    // derived from trusted Cloud Functions triggers reacting to a Reel's
    // own publish/delete/engagement-stats changes — there is no
    // analogous "one clearly-bounded client operation" to safely carve
    // out the way hashtags/{hashtagId}'s exact `postCount + 1` is. This
    // is discovery/public-app data for any authenticated Around Me user
    // (Step 34) — same `isSignedIn()`-only read bar as hashtags/
    // {hashtagId} above; no per-user scoping, since a trend is
    // inherently about a city, not a viewer.
    match /cityHashtagTrends/{docId} {
      allow read: if isSignedIn();

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // stories/{storyId} — a separate root collection from reels/{reelId}
    // (see src/types/story.ts for why Stories don't share the Reel model).
    // Same two-phase lifecycle as Reels: "uploading" -> "published" (see
    // src/services/stories.ts). UNLIKE Reels, visibility is
    // followers-only, not city-wide — see isCanViewStory below — and there
    // is no cascade to clean up on delete (no likes/comments/thumbnail/
    // music, unlike a Reel).
    match /stories/{storyId} {
      // The author can always read their own Story (including a still-
      // "uploading" draft, needed for the upload workflow — same
      // reasoning as reels/{reelId}'s own read rule). Anyone else may read
      // it ONLY once published AND only if they follow the author AND
      // neither has blocked the other — see isCanViewStory.
      allow read: if isSignedIn() && isCanViewStory(resource.data);

      allow create: if isSignedIn() && isValidStoryCreate(storyId, request.resource.data);

      // Two allowed updates: uploading -> published (stamping
      // publishedAt/expiresAt — expiresAt is bounded to a narrow window
      // around request.time + 24h, see STORY_EXPIRY_MS in
      // src/types/story.ts, a client-computed value, not server-
      // authoritative, so this caps how far it can be pushed out rather
      // than trusting it outright), and Step 10A's own narrow, one-time
      // "media moved to R2" flip (isValidStoryProviderUpdate) — every
      // other field is immutable in both.
      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && (
          isValidStoryPublish(request.resource.data, resource.data)
          || isValidStoryProviderUpdate(request.resource.data, resource.data)
        );

      // The author may delete their own Story at any time (Instagram-style
      // "delete my Story" — see deleteMyStory in src/services/stories.ts),
      // uploading or published — unlike a published Reel, which can never
      // be client-deleted (a Story has no cascade to worry about).
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      // stories/{storyId}/views/{viewerUid} — one doc per person who has
      // viewed this Story, keyed by their own uid (write-once-per-viewer;
      // a repeat view is an update, just refreshing viewedAt). Only the
      // Story's own author can ever READ this subcollection — a viewer
      // must never learn who else viewed it, matching real Stories
      // features' privacy model. A viewer may only write their OWN entry,
      // and only if they're actually allowed to view the parent Story in
      // the first place (isCanViewStory again, evaluated against the
      // PARENT story document, not this views doc).
      match /views/{viewerUid} {
        allow read: if isSignedIn()
          && (
            request.auth.uid == viewerUid
            || get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid
          );

        allow create, update: if isSignedIn()
          && request.auth.uid == viewerUid
          && isCanViewStory(get(/databases/$(database)/documents/stories/$(storyId)).data)
          && request.resource.data.viewerUid == viewerUid
          && isServerTimestamp(request.resource.data.viewedAt)
          && request.resource.data.keys().hasOnly(['viewerUid', 'viewedAt']);

        allow delete: if false;
      }
    }

    function isCanViewStory(story) {
      return story.authorUid == request.auth.uid
        || (
          story.status == 'published'
          && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + story.authorUid))
          && isNotBlockedEitherWay(request.auth.uid, story.authorUid)
        );
    }

    function storyBaseKeys() {
      return [
        'storyId', 'authorUid', 'authorDisplayName', 'authorUsername',
        'mediaType', 'storagePath', 'storageContentType', 'fileSizeBytes',
        'durationMs', 'width', 'height', 'status',
        'storageProvider', 'mediaUrl', 'sourceNormalized',
        'createdAt', 'updatedAt', 'publishedAt', 'expiresAt'
      ];
    }

    function isValidStoryCreate(storyId, data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile.onboardingCompleted == true
        && data.storyId == storyId
        && data.authorUid == request.auth.uid
        && data.authorDisplayName == profile.displayName
        && data.authorUsername == profile.username
        && data.mediaType in ['video', 'photo']
        && data.storagePath == 'stories/' + request.auth.uid + '/' + storyId + '/source'
        // Step 10A — same "required field, fixed default at create"
        // pattern as a Reel's own storageProvider/sourceUrl (see
        // isValidReelCreate) — a client can never create a draft already
        // claiming R2; only the narrow, one-time isValidStoryProviderUpdate
        // transition below can ever flip this.
        && data.storageProvider == 'firebase'
        && data.mediaUrl == ''
        // Step 11C — every draft is created not-yet-normalized, same
        // "required field, fixed default at create" pattern as a Reel's
        // own sourceNormalized (see isValidReelCreate) — applied
        // uniformly regardless of mediaType (a photo Story never gets
        // this flipped to true — see isValidStoryPublish below, which
        // exempts photo Stories from the gate entirely). Only a trusted
        // Cloud Function (finalizeStoryVideo, via the Admin SDK) can ever
        // flip this to true for a direct video Story; addReelToMyStory
        // (also Admin SDK) may set it true directly at CREATE time for a
        // Reel->Story copy, since that write bypasses this predicate
        // entirely (allow create only governs CLIENT writes).
        && data.sourceNormalized == false
        && (
          (
            data.mediaType == 'video'
            && data.storageContentType is string
            && data.storageContentType.matches('video/.*')
            && data.fileSizeBytes is int
            && data.fileSizeBytes > 0
            && data.fileSizeBytes <= 52428800
            && data.durationMs is int
            && data.durationMs > 0
            && data.durationMs <= 60000
          ) || (
            data.mediaType == 'photo'
            && data.storageContentType is string
            && data.storageContentType.matches('image/.*')
            && data.fileSizeBytes is int
            && data.fileSizeBytes > 0
            && data.fileSizeBytes <= 10485760
            && data.durationMs == 0
          )
        )
        && data.width is number
        && data.width > 0
        && data.height is number
        && data.height > 0
        && data.status == 'uploading'
        && data.publishedAt == null
        && data.expiresAt == null
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly(storyBaseKeys());
    }

    // Every field except status/publishedAt/expiresAt/updatedAt must stay
    // byte-identical to what create validated — same "nothing else can
    // change on publish" reasoning as isValidReelPublish above.
    function isValidStoryPublish(newData, oldData) {
      return oldData.status == 'uploading'
        && newData.status == 'published'
        && oldData.publishedAt == null
        && isServerTimestamp(newData.publishedAt)
        && isServerTimestamp(newData.updatedAt)
        // expiresAt is client-computed (see Story.expiresAt's own doc
        // comment in src/types/story.ts) — bounded to within 10 minutes of
        // exactly request.time + 24h, wide enough to absorb ordinary clock
        // skew/upload latency, narrow enough that a client can't fabricate
        // a meaningfully longer-lived Story.
        && newData.expiresAt is timestamp
        && newData.expiresAt > request.time + duration.value(23, 'h') + duration.value(50, 'm')
        && newData.expiresAt < request.time + duration.value(24, 'h') + duration.value(10, 'm')
        && newData.storyId == oldData.storyId
        && newData.authorUid == oldData.authorUid
        && newData.authorDisplayName == oldData.authorDisplayName
        && newData.authorUsername == oldData.authorUsername
        && newData.mediaType == oldData.mediaType
        // Step 11C — a VIDEO Story can never publish until its source has
        // actually been through finalizeStoryVideo (which stamps
        // sourceNormalized: true in its own Admin-SDK confirm-write,
        // bypassing these Rules entirely). A plain PHOTO Story is exempt:
        // it is never transcoded at all (Part 4 of the Step 11C spec) —
        // same exemption pattern as isValidReelPublish's own
        // `mediaType == 'photo'` carve-out. A REEL-COPIED Story
        // (addReelToMyStory) is created ALREADY published — it never
        // reaches this transition at all, so this gate only ever governs
        // a direct capture/picker Story's own client-driven publish.
        && (oldData.mediaType == 'photo' || oldData.sourceNormalized == true)
        && newData.sourceNormalized == oldData.sourceNormalized
        && newData.storagePath == oldData.storagePath
        && newData.storageContentType == oldData.storageContentType
        && newData.fileSizeBytes == oldData.fileSizeBytes
        && newData.durationMs == oldData.durationMs
        && newData.width == oldData.width
        && newData.height == oldData.height
        // Step 10A — the Story's own provider/URL must stay unchanged
        // during a PUBLISH-only transition — same mutual-exclusion
        // reasoning as isValidReelThumbnailProviderUpdate's own new
        // storageProvider/sourceUrl equality checks for Reels. Without
        // this, a client could piggyback a provider change through this
        // rule the moment both fields existed in the schema.
        && newData.storageProvider == oldData.storageProvider
        && newData.mediaUrl == oldData.mediaUrl
        && newData.createdAt == oldData.createdAt
        && newData.keys().hasOnly(storyBaseKeys());
    }

    // Step 10A — a still-"uploading" Story's own media moving from
    // Firebase to R2, once (and only once) a direct client upload to R2
    // has actually succeeded (see
    // functions/src/media/requestMediaUploadAuthorization.ts's own
    // verifyStoryMediaOwnership for the server-side authorization that
    // must happen BEFORE that upload, and src/services/stories.ts's
    // confirmStoryMediaProvider, the only client-side caller of this
    // path). `oldData.storageProvider == 'firebase'` is what makes this
    // fire at most once ever per Story, exactly mirroring
    // isValidReelSourceProviderUpdate's own one-shot guard. Every other
    // field must stay byte-identical — same "no sneaking an unrelated
    // change through this narrow door" reasoning as every other
    // provider-transition rule in this file.
    function isValidStoryProviderUpdate(newData, oldData) {
      return oldData.status == 'uploading'
        && newData.status == 'uploading'
        && oldData.storageProvider == 'firebase'
        && newData.storageProvider == 'r2'
        && newData.mediaUrl is string
        && newData.mediaUrl.size() > 0
        && newData.mediaUrl.size() <= 2048
        && newData.mediaUrl.matches('https://.*')
        && isServerTimestamp(newData.updatedAt)
        && newData.storyId == oldData.storyId
        && newData.authorUid == oldData.authorUid
        && newData.authorDisplayName == oldData.authorDisplayName
        && newData.authorUsername == oldData.authorUsername
        && newData.mediaType == oldData.mediaType
        && newData.storagePath == oldData.storagePath
        && newData.storageContentType == oldData.storageContentType
        && newData.fileSizeBytes == oldData.fileSizeBytes
        && newData.durationMs == oldData.durationMs
        && newData.width == oldData.width
        && newData.height == oldData.height
        && newData.sourceNormalized == oldData.sourceNormalized
        && newData.publishedAt == oldData.publishedAt
        && newData.expiresAt == oldData.expiresAt
        && newData.createdAt == oldData.createdAt
        && newData.keys().hasOnly(storyBaseKeys());
    }

    // notifications/{notificationId} — one social notification per Like,
    // Comment, or Follow (see src/types/notification.ts). These are always
    // written atomically with their underlying action (writeBatch, in
    // src/services/socialEngagement.ts and src/services/following.ts), and
    // every create here is independently re-validated against that action —
    // a client can never fabricate a notification ("X followed you" with no
    // real follow edge) no matter what it sends.
    match /notifications/{notificationId} {
      // resource == null (no such notification) is allowed here on purpose
      // — same reasoning as the conversations read rule below: reading a
      // nonexistent document reveals no data, and src/services/blocks.ts
      // needs to check "does a notification exist for this follow edge?"
      // for follow edges that may predate this notifications feature
      // (created before Step 15) and therefore have no paired notification
      // — without this, that existence check would itself be denied.
      //
      // Step 38 — event_response/activity_join notifications additionally
      // let their own ACTOR read them (not just the recipient). This is a
      // narrow widening scoped to only these two types: setEventResponse
      // needs to read its own prior notification to decide create vs.
      // update when Interested/Going changes, and removeEventResponse/
      // leaveActivity need to check "does my generated notification still
      // exist" before conditionally deleting it — an unconditional delete
      // of a possibly-nonexistent doc would otherwise risk exactly the
      // null-`resource` failure documented above. The actor already knows
      // everything in their own generated notification (they supplied
      // actorUid/actorDisplayName/actorUsername/contentId/type themselves)
      // except its `read` state — a minor, narrowly-scoped exposure,
      // unchanged for every other notification type.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.recipientUid == request.auth.uid
        || (resource.data.actorUid == request.auth.uid && (resource.data.type == 'event_response' || resource.data.type == 'activity_join'))
      );

      allow create: if isSignedIn()
        && isValidNotificationActor(request.resource.data)
        && isValidNotificationBase(notificationId, request.resource.data)
        && (
          isValidLikeNotification(notificationId, request.resource.data)
          || isValidCommentNotification(notificationId, request.resource.data)
          || isValidFollowNotification(notificationId, request.resource.data)
          || isValidReelLikeNotification(notificationId, request.resource.data)
          || isValidReelCommentNotification(notificationId, request.resource.data)
          || isValidEventResponseNotification(notificationId, request.resource.data)
          || isValidActivityJoinNotification(notificationId, request.resource.data)
        );

      // Two structurally different callers can update a notification: the
      // RECIPIENT toggling read state (every type), or the ACTOR of an
      // event_response notification switching Interested <-> Going (Step
      // 38) — the only notification type whose non-read state is ever
      // mutable. These are deliberately separate functions rather than one
      // combined one, since they're authorized by different people.
      allow update: if isSignedIn() && (
        isValidNotificationReadUpdate(request.resource.data, resource.data)
        || isValidEventResponseStateUpdate(request.resource.data, resource.data)
      );

      allow delete: if isSignedIn() && isValidNotificationDelete(resource.data);
    }

    // The actor snapshot (actorDisplayName/actorUsername) must match the
    // caller's OWN public profile, and a notification can never target
    // yourself — self-like/self-comment/self-follow never produce one (see
    // the service layer, which already skips the write; this is the
    // server-side backstop).
    function isValidNotificationActor(data) {
      let profile = get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data;
      return data.actorUid == request.auth.uid
        && data.recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && data.actorDisplayName == profile.displayName
        && data.actorUsername == profile.username;
    }

    function isValidNotificationBase(notificationId, data) {
      return data.notificationId == notificationId
        && data.read == false
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly([
          'notificationId', 'recipientUid', 'actorUid', 'actorDisplayName', 'actorUsername',
          'type', 'contentId', 'reelId', 'commentId', 'previewText', 'responseStatus', 'read', 'createdAt', 'updatedAt'
        ]);
    }

    // The deterministic ID ties this doc to one exact (content, actor) pair,
    // and existsAfter() on the Like doc proves a real Like landed in the
    // same batch — not just a claim that one exists. reelId == null keeps
    // this type from ever being paired with a Reel reference (see
    // isValidReelLikeNotification below for that pairing instead).
    function isValidLikeNotification(notificationId, data) {
      let contentPath = /databases/$(database)/documents/content/$(data.contentId);
      return data.type == 'like'
        && data.contentId is string
        && data.reelId == null
        && data.commentId == null
        && data.previewText == null
        && data.responseStatus == null
        && notificationId == 'like_' + data.contentId + '_' + data.actorUid
        && exists(contentPath)
        && get(contentPath).data.status == 'published'
        && get(contentPath).data.authorUid == data.recipientUid
        && existsAfter(/databases/$(database)/documents/content/$(data.contentId)/likes/$(data.actorUid));
    }

    // Same idea for comments: the ID is tied to one exact comment, and the
    // comment must actually exist (in the same batch) and be authored by
    // the notification's claimed actor.
    function isValidCommentNotification(notificationId, data) {
      let contentPath = /databases/$(database)/documents/content/$(data.contentId);
      let commentPath = /databases/$(database)/documents/content/$(data.contentId)/comments/$(data.commentId);
      return data.type == 'comment'
        && data.contentId is string
        && data.reelId == null
        && data.commentId is string
        && data.responseStatus == null
        && notificationId == 'comment_' + data.commentId
        && (data.previewText == null || (data.previewText is string && data.previewText.size() <= 500))
        && exists(contentPath)
        && get(contentPath).data.status == 'published'
        && get(contentPath).data.authorUid == data.recipientUid
        && existsAfter(commentPath)
        && getAfter(commentPath).data.authorUid == data.actorUid;
    }

    // And for follows: the ID is tied to one exact (actor, recipient) edge,
    // and that edge must actually exist (in the same batch) with matching
    // follower/following uids.
    function isValidFollowNotification(notificationId, data) {
      let followPath = /databases/$(database)/documents/follows/$(data.actorUid + '_' + data.recipientUid);
      return data.type == 'follow'
        && data.contentId == null
        && data.reelId == null
        && data.commentId == null
        && data.previewText == null
        && data.responseStatus == null
        && notificationId == 'follow_' + data.actorUid + '_' + data.recipientUid
        && exists(/databases/$(database)/documents/publicProfiles/$(data.recipientUid))
        && existsAfter(followPath)
        && getAfter(followPath).data.followerUid == data.actorUid
        && getAfter(followPath).data.followingUid == data.recipientUid;
    }

    // Reels are a separate root collection from content/{contentId} (see
    // reels/{reelId} above), so reel_like/reel_comment reference reelId
    // directly rather than reusing the content notification validators —
    // same reasoning as isValidReelReport in the reports section below.
    // The deterministic ID and existsAfter() check on the Reel Like doc are
    // exactly the same pairing guarantee as isValidLikeNotification.
    function isValidReelLikeNotification(notificationId, data) {
      let reelPath = /databases/$(database)/documents/reels/$(data.reelId);
      return data.type == 'reel_like'
        && data.reelId is string
        && data.contentId == null
        && data.commentId == null
        && data.previewText == null
        && data.responseStatus == null
        && notificationId == 'reel_like_' + data.reelId + '_' + data.actorUid
        && exists(reelPath)
        && get(reelPath).data.status == 'published'
        && get(reelPath).data.authorUid == data.recipientUid
        && existsAfter(/databases/$(database)/documents/reels/$(data.reelId)/likes/$(data.actorUid));
    }

    function isValidReelCommentNotification(notificationId, data) {
      let reelPath = /databases/$(database)/documents/reels/$(data.reelId);
      let commentPath = /databases/$(database)/documents/reels/$(data.reelId)/comments/$(data.commentId);
      return data.type == 'reel_comment'
        && data.reelId is string
        && data.contentId == null
        && data.commentId is string
        && data.responseStatus == null
        && notificationId == 'reel_comment_' + data.commentId
        && (data.previewText == null || (data.previewText is string && data.previewText.size() <= 500))
        && exists(reelPath)
        && get(reelPath).data.status == 'published'
        && get(reelPath).data.authorUid == data.recipientUid
        && existsAfter(commentPath)
        && getAfter(commentPath).data.authorUid == data.actorUid;
    }

    // Step 38 — Event responses (Interested/Going). ONE logical
    // notification per (event, actor): the deterministic ID has no
    // Interested/Going distinction, so switching between them is always an
    // update to this same document (see isValidEventResponseStateUpdate
    // below), never a second create. existsAfter() on the response doc,
    // AND that its status matches responseStatus, proves a real Interested
    // or Going response landed in the same transaction as this
    // notification create — not just a claim.
    function isValidEventResponseNotification(notificationId, data) {
      let eventPath = /databases/$(database)/documents/content/$(data.contentId);
      let responsePath = /databases/$(database)/documents/content/$(data.contentId)/responses/$(data.actorUid);
      return data.type == 'event_response'
        && data.contentId is string
        && data.reelId == null
        && data.commentId == null
        && data.previewText == null
        && (data.responseStatus == 'interested' || data.responseStatus == 'going')
        && notificationId == 'event_response_' + data.contentId + '_' + data.actorUid
        && exists(eventPath)
        && get(eventPath).data.type == 'event'
        && get(eventPath).data.status == 'published'
        && get(eventPath).data.authorUid == data.recipientUid
        && existsAfter(responsePath)
        && getAfter(responsePath).data.uid == data.actorUid
        && getAfter(responsePath).data.status == data.responseStatus;
    }

    // Step 38 — Activity joins. One notification per (activity, actor)
    // that exists only while the actor is joined (see
    // isValidNotificationDelete below for the paired leave-time delete
    // rule). existsAfter() on the participant doc proves a real join
    // landed in the same transaction — never a bare claim.
    function isValidActivityJoinNotification(notificationId, data) {
      let activityPath = /databases/$(database)/documents/content/$(data.contentId);
      let participantPath = /databases/$(database)/documents/content/$(data.contentId)/participants/$(data.actorUid);
      return data.type == 'activity_join'
        && data.contentId is string
        && data.reelId == null
        && data.commentId == null
        && data.previewText == null
        && data.responseStatus == null
        && notificationId == 'activity_join_' + data.contentId + '_' + data.actorUid
        && exists(activityPath)
        && get(activityPath).data.type == 'activity'
        && get(activityPath).data.status == 'published'
        && get(activityPath).data.authorUid == data.recipientUid
        && existsAfter(participantPath);
    }

    // Only the recipient, and only to toggle read state — every other
    // field, including actorUid/recipientUid/type, must stay byte-identical
    // to what create validated. Nobody can "retarget" or "relabel" an
    // existing notification via update. reelId/responseStatus are read via
    // .get() with a null default (not plain dot access) because
    // notifications created before Step 19 (reelId) / Step 38
    // (responseStatus) predate those fields entirely and genuinely lack
    // the key — plain dot access on a missing map key errors out the whole
    // rule evaluation, which would have broken mark-as-read for every
    // pre-existing notification. New writes always set both explicitly
    // (null for types that don't use them — see src/types/notification.ts),
    // so this only ever matters for reading OLD stored documents.
    function isValidNotificationReadUpdate(newData, oldData) {
      return oldData.recipientUid == request.auth.uid
        && newData.notificationId == oldData.notificationId
        && newData.recipientUid == oldData.recipientUid
        && newData.actorUid == oldData.actorUid
        && newData.actorDisplayName == oldData.actorDisplayName
        && newData.actorUsername == oldData.actorUsername
        && newData.type == oldData.type
        && newData.contentId == oldData.contentId
        && newData.get('reelId', null) == oldData.get('reelId', null)
        && newData.commentId == oldData.commentId
        && newData.previewText == oldData.previewText
        && newData.get('responseStatus', null) == oldData.get('responseStatus', null)
        && newData.createdAt == oldData.createdAt
        && newData.read is bool
        && isServerTimestamp(newData.updatedAt)
        && newData.keys().hasOnly([
          'notificationId', 'recipientUid', 'actorUid', 'actorDisplayName', 'actorUsername',
          'type', 'contentId', 'reelId', 'commentId', 'previewText', 'responseStatus', 'read', 'createdAt', 'updatedAt'
        ]);
    }

    // Step 38 — the ONLY notification field (besides read/timestamps) that
    // is ever mutable, and only for event_response, and only by the ACTOR
    // (not the recipient — see isValidNotificationReadUpdate above for
    // that side). Interested <-> Going updates this SAME document rather
    // than creating a second one. Identity fields (actorUid/recipientUid/
    // contentId/type) stay immutable; responseStatus must actually change
    // (Step 38 Section 13 — tapping the same state again is a no-op the
    // client never even calls this for, but the rule enforces it as a
    // backstop too) and must match the real underlying response
    // (getAfter) — a client can never claim "Going" while the response
    // doc still says "interested". createdAt is deliberately bumped to a
    // fresh server timestamp here (not preserved) and read forced back to
    // false: the Event creator should see this as a NEW Activity update,
    // sorted to the top of their Inbox by createdAt — not a stale entry
    // wherever the original response first landed (Step 38 Section 23).
    function isValidEventResponseStateUpdate(newData, oldData) {
      let responsePath = /databases/$(database)/documents/content/$(oldData.contentId)/responses/$(oldData.actorUid);
      return oldData.type == 'event_response'
        && oldData.actorUid == request.auth.uid
        && newData.notificationId == oldData.notificationId
        && newData.recipientUid == oldData.recipientUid
        && newData.actorUid == oldData.actorUid
        && newData.actorDisplayName == oldData.actorDisplayName
        && newData.actorUsername == oldData.actorUsername
        && newData.type == oldData.type
        && newData.contentId == oldData.contentId
        && newData.reelId == oldData.reelId
        && newData.commentId == oldData.commentId
        && newData.previewText == oldData.previewText
        && (newData.responseStatus == 'interested' || newData.responseStatus == 'going')
        && newData.responseStatus != oldData.get('responseStatus', null)
        && newData.read == false
        && isServerTimestamp(newData.createdAt)
        && isServerTimestamp(newData.updatedAt)
        && existsAfter(responsePath)
        && getAfter(responsePath).data.uid == oldData.actorUid
        && getAfter(responsePath).data.status == newData.responseStatus
        && newData.keys().hasOnly([
          'notificationId', 'recipientUid', 'actorUid', 'actorDisplayName', 'actorUsername',
          'type', 'contentId', 'reelId', 'commentId', 'previewText', 'responseStatus', 'read', 'createdAt', 'updatedAt'
        ]);
    }

    // Recipients can always clear their own inbox. Actors may only delete a
    // notification they generated as part of genuinely undoing the same
    // action (unlike/delete-comment/unfollow/removing an Event response/
    // leaving an Activity) in the same batch/transaction — this keeps
    // "notification exists iff the action exists" true from the actor's
    // side too, instead of letting an actor delete a notification while
    // leaving the Like/Comment/Follow/response/participation it came from
    // intact.
    function isValidNotificationDelete(data) {
      return data.recipientUid == request.auth.uid
        || (
          data.actorUid == request.auth.uid
          && (
            (data.type == 'like' && !existsAfter(/databases/$(database)/documents/content/$(data.contentId)/likes/$(data.actorUid)))
            || (data.type == 'comment' && !existsAfter(/databases/$(database)/documents/content/$(data.contentId)/comments/$(data.commentId)))
            || (data.type == 'follow' && !existsAfter(/databases/$(database)/documents/follows/$(data.actorUid + '_' + data.recipientUid)))
            || (data.type == 'reel_like' && !existsAfter(/databases/$(database)/documents/reels/$(data.reelId)/likes/$(data.actorUid)))
            || (data.type == 'reel_comment' && !existsAfter(/databases/$(database)/documents/reels/$(data.reelId)/comments/$(data.commentId)))
            || (data.type == 'event_response' && !existsAfter(/databases/$(database)/documents/content/$(data.contentId)/responses/$(data.actorUid)))
            || (data.type == 'activity_join' && !existsAfter(/databases/$(database)/documents/content/$(data.contentId)/participants/$(data.actorUid)))
          )
        );
    }

    // conversations/{conversationId} — a private 1:1 direct-message thread
    // between exactly two users (see src/services/messages.ts and
    // src/types/message.ts). conversationId is the canonical
    // `{lowerUid}_{higherUid}` pairing — Firestore Rules support the same
    // lexicographic `<` ordering on strings that JavaScript's `<` uses for
    // ASCII uids, so the client and these rules always agree on which uid
    // sorts first. This is what guarantees at most one 1:1 conversation
    // per user pair, no matter who starts it — verified explicitly by the
    // rules test suite's "conversation uniqueness" checks, not assumed.
    match /conversations/{conversationId} {
      // resource == null (the conversation doesn't exist yet) is allowed
      // here on purpose: a nonexistent document has no data to protect, and
      // sendMessage's own existence pre-check (does this pair already have
      // a conversation?) needs to be able to ask that question for a
      // conversation that legitimately might not exist yet — without this,
      // that pre-check read itself would be denied (resource.data would be
      // null.data, an evaluation error) before a first message could ever
      // be sent.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantUids);

      allow create: if isSignedIn() && isValidConversationCreate(conversationId, request.resource.data);

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids
        && (isValidConversationSend(request.resource.data, resource.data) || isValidMarkRead(request.resource.data, resource.data));

      // Firestore never cascade-deletes the messages subcollection, and
      // there's no delete UI yet — same reasoning as content delete above.
      allow delete: if false;

      // conversations/{conversationId}/messages/{messageId} — text-only,
      // create + read only (no edit/delete in Step 16 — see
      // isValidMessageCreate). Always paired with a Conversation
      // create/update in the same transaction (src/services/messages.ts),
      // and independently re-validated against it below so a modified
      // client can never write a message the Conversation doesn't
      // reference as its latest.
      match /messages/{messageId} {
        function conversationPath() {
          return /databases/$(database)/documents/conversations/$(conversationId);
        }

        // Same reasoning as the conversations read rule above: the Chat
        // screen queries this subcollection immediately on open, before
        // any message (and therefore before the Conversation itself) may
        // exist yet. A plain get() on a nonexistent Conversation throws in
        // rules, so that query must be allowed to return "nothing" rather
        // than error — there's no data to protect when the conversation
        // doesn't exist. Once it exists, only real participants may read.
        allow read: if isSignedIn()
          && (!exists(conversationPath()) || request.auth.uid in get(conversationPath()).data.participantUids);

        allow create: if isSignedIn() && isValidMessageCreate(conversationId, messageId, request.resource.data);

        allow update: if false;
        allow delete: if false;
      }
    }

    function otherParticipant(participantUids, uid) {
      return participantUids[0] == uid ? participantUids[1] : participantUids[0];
    }

    function conversationBaseKeys() {
      return [
        'conversationId', 'participantUids', 'lastMessageId', 'lastMessageText',
        'lastMessageSenderUid', 'lastMessageAt', 'unreadCounts', 'createdAt', 'updatedAt'
      ];
    }

    // Requires the two-uid array to be stored in the exact SAME sorted
    // order the ID is derived from — one canonical representation per
    // pair, not two, and self-conversations are impossible since a value
    // can never be strictly less than itself.
    function isValidParticipantPair(participantUids) {
      return participantUids is list
        && participantUids.size() == 2
        && participantUids[0] is string
        && participantUids[1] is string
        && participantUids[0] < participantUids[1];
    }

    // "everyone"/no doc: any signed-in sender may start a conversation.
    // "people_i_follow": the RECIPIENT must already follow the SENDER —
    // i.e. follows/{recipientUid}_{senderUid} — this is "people I follow
    // may message me," not "people who follow me" (those are opposite
    // directions and easy to swap by accident). "nobody": no new
    // conversation, full stop. This only ever gates conversation CREATE —
    // see isValidConversationSend, which never re-checks it.
    function isNewConversationAllowedByPrivacy(senderUid, recipientUid) {
      let settingsPath = /databases/$(database)/documents/privacySettings/$(recipientUid);
      return !exists(settingsPath)
        || get(settingsPath).data.newMessagesFrom == 'everyone'
        || (
          get(settingsPath).data.newMessagesFrom == 'people_i_follow'
          && exists(/databases/$(database)/documents/follows/$(recipientUid + '_' + senderUid))
        );
    }

    function isValidConversationCreate(conversationId, data) {
      let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(data.lastMessageId);
      return isValidParticipantPair(data.participantUids)
        && conversationId == data.participantUids[0] + '_' + data.participantUids[1]
        && request.auth.uid in data.participantUids
        && exists(/databases/$(database)/documents/publicProfiles/$(data.participantUids[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(data.participantUids[1]))
        && isNotBlockedEitherWay(data.participantUids[0], data.participantUids[1])
        && isNewConversationAllowedByPrivacy(request.auth.uid, otherParticipant(data.participantUids, request.auth.uid))
        && data.conversationId == conversationId
        && data.lastMessageSenderUid == request.auth.uid
        && data.lastMessageText is string
        && isServerTimestamp(data.lastMessageAt)
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.unreadCounts.size() == 2
        && data.unreadCounts[request.auth.uid] == 0
        && data.unreadCounts[otherParticipant(data.participantUids, request.auth.uid)] == 1
        && data.keys().hasOnly(conversationBaseKeys())
        // The paired first Message must exist (in this same transaction)
        // and match the Conversation's claimed last-message fields exactly
        // — a client can never point lastMessage* at a message that isn't
        // really there, or that says something different.
        && existsAfter(messagePath)
        && getAfter(messagePath).data.senderUid == request.auth.uid
        && getAfter(messagePath).data.body == data.lastMessageText
        && getAfter(messagePath).data.createdAt == data.lastMessageAt;
    }

    // A normal send on an ALREADY-EXISTING conversation: identity fields
    // are immutable, and the last-message snapshot + unread counts can
    // only move in the one direction a real send actually moves them.
    function isValidConversationSend(newData, oldData) {
      let sender = request.auth.uid;
      let other = otherParticipant(oldData.participantUids, sender);
      let messagePath = /databases/$(database)/documents/conversations/$(oldData.conversationId)/messages/$(newData.lastMessageId);
      return newData.conversationId == oldData.conversationId
        && newData.participantUids == oldData.participantUids
        && newData.createdAt == oldData.createdAt
        && newData.lastMessageId != oldData.lastMessageId
        && newData.lastMessageSenderUid == sender
        && newData.lastMessageText is string
        // Blocks stop an EXISTING conversation from continuing; message
        // privacy (isNewConversationAllowedByPrivacy) deliberately does
        // NOT apply here — see isValidConversationCreate for where it
        // does apply (starting a brand new conversation only).
        && isNotBlockedEitherWay(sender, other)
        && isServerTimestamp(newData.lastMessageAt)
        && isServerTimestamp(newData.updatedAt)
        && newData.unreadCounts.size() == 2
        && newData.unreadCounts[sender] == 0
        && newData.unreadCounts[other] == oldData.unreadCounts[other] + 1
        && newData.keys().hasOnly(conversationBaseKeys())
        // The paired new Message must exist (in this same transaction)
        // and match exactly — same pairing guarantee as create.
        && existsAfter(messagePath)
        && getAfter(messagePath).data.senderUid == sender
        && getAfter(messagePath).data.body == newData.lastMessageText
        && getAfter(messagePath).data.createdAt == newData.lastMessageAt;
    }

    // markConversationRead: the ONLY thing allowed to change is the
    // caller's own unreadCounts entry, and only down to 0. Every other
    // field — including the other participant's unread count — must stay
    // byte-identical to what was there before.
    function isValidMarkRead(newData, oldData) {
      let uid = request.auth.uid;
      let other = otherParticipant(oldData.participantUids, uid);
      return newData.conversationId == oldData.conversationId
        && newData.participantUids == oldData.participantUids
        && newData.createdAt == oldData.createdAt
        && newData.updatedAt == oldData.updatedAt
        && newData.lastMessageId == oldData.lastMessageId
        && newData.lastMessageText == oldData.lastMessageText
        && newData.lastMessageSenderUid == oldData.lastMessageSenderUid
        && newData.lastMessageAt == oldData.lastMessageAt
        && newData.unreadCounts.size() == 2
        && newData.unreadCounts[uid] == 0
        && newData.unreadCounts[other] == oldData.unreadCounts[other]
        && newData.keys().hasOnly(conversationBaseKeys());
    }

    function isValidMessageCreate(conversationId, messageId, data) {
      let convPath = /databases/$(database)/documents/conversations/$(conversationId);
      let convAfter = getAfter(convPath).data;
      return existsAfter(convPath)
        && request.auth.uid in convAfter.participantUids
        && data.messageId == messageId
        && data.senderUid == request.auth.uid
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 1000
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly(['messageId', 'senderUid', 'body', 'createdAt'])
        // The paired Conversation write (whether this message is the
        // FIRST one — creating the Conversation in the same transaction —
        // or a later one on an existing Conversation) must reference this
        // exact message as its latest. Checking the POST-write state
        // (getAfter) rather than the pre-write state is what makes this
        // one check correct for both cases.
        && convAfter.lastMessageId == messageId
        && convAfter.lastMessageSenderUid == request.auth.uid
        && convAfter.lastMessageText == data.body
        && convAfter.lastMessageAt == data.createdAt;
    }

    // blocks/{blockerUid}_{blockedUid} — a directed "A blocks B" edge (see
    // src/services/blocks.ts and src/types/block.ts). Prevents NEW follow/
    // like/comment/message interaction in both directions (see
    // isNotBlockedEitherWay above and its call sites) without erasing any
    // existing history. Only the blocker may ever read their own block
    // doc — the blocked user is never told they were blocked, by design.
    match /blocks/{blockId} {
      // resource == null (no such block) is allowed here on purpose, for
      // two real client call sites: blockUser()'s own "is this already
      // blocked?" pre-check — the common case for a FIRST-time block,
      // where the answer is legitimately "no" — and unblockUser()'s
      // delete, which must be a harmless no-op (not an error) if the
      // block was already removed. Reading/deleting nothing reveals and
      // changes nothing.
      allow read: if isSignedIn() && (resource == null || resource.data.blockerUid == request.auth.uid);

      allow create: if isSignedIn() && isValidBlockCreate(blockId, request.resource.data);

      allow update: if false;

      allow delete: if isSignedIn() && (resource == null || resource.data.blockerUid == request.auth.uid);
    }

    function isValidBlockCreate(blockId, data) {
      return data.blockerUid == request.auth.uid
        && data.blockedUid != request.auth.uid
        && blockId == data.blockerUid + '_' + data.blockedUid
        && exists(/databases/$(database)/documents/publicProfiles/$(data.blockerUid))
        && exists(/databases/$(database)/documents/publicProfiles/$(data.blockedUid))
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly(['blockId', 'blockerUid', 'blockedUid', 'createdAt']);
    }

    // privacySettings/{uid} — who may START a new DM conversation with
    // this user (see src/types/privacy.ts and isNewConversationAllowedByPrivacy
    // above). Readable by any signed-in user: a prospective sender's own
    // conversation-create write needs this doc to exist-check against,
    // and it contains no sensitive data beyond this one public-safe
    // preference. Never affects an existing conversation — only Blocks do.
    match /privacySettings/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid) && isValidPrivacySettingsCreate(uid, request.resource.data);

      allow update: if isOwner(uid) && isValidPrivacySettingsUpdate(request.resource.data, resource.data);

      allow delete: if false;
    }

    function isValidNewMessagesFromEnum(value) {
      return value == 'everyone' || value == 'people_i_follow' || value == 'nobody';
    }

    function isValidPrivacySettingsCreate(uid, data) {
      return data.uid == uid
        && isValidNewMessagesFromEnum(data.newMessagesFrom)
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly(['uid', 'newMessagesFrom', 'createdAt', 'updatedAt']);
    }

    function isValidPrivacySettingsUpdate(newData, oldData) {
      return newData.uid == oldData.uid
        && newData.createdAt == oldData.createdAt
        && isValidNewMessagesFromEnum(newData.newMessagesFrom)
        && isServerTimestamp(newData.updatedAt)
        && newData.keys().hasOnly(['uid', 'newMessagesFrom', 'createdAt', 'updatedAt']);
    }

    // reports/{reportId} — private moderation records (see
    // src/types/report.ts and src/services/reports.ts). Create-only from
    // the client; there is no moderation UI yet, so nothing is ever
    // updated or deleted client-side. Only the reporter may ever read
    // their own submitted report — never the reported user, never anyone
    // else. reportId is deterministic per (reporter, target) so a second
    // create for the same target is evaluated as an "update" (denied),
    // which is what actually stops duplicate-report spam.
    match /reports/{reportId} {
      // resource == null (no such report) is allowed here on purpose —
      // src/services/reports.ts's own duplicate-report pre-check needs to
      // ask "does a report already exist for this target?" for a FIRST-time
      // report, the common case, where the honest answer is "no." Reading
      // nothing reveals nothing.
      allow read: if isSignedIn() && (resource == null || resource.data.reporterUid == request.auth.uid);

      allow create: if isSignedIn() && isValidReportCreate(reportId, request.resource.data);

      allow update: if false;

      allow delete: if false;
    }

    function isValidReportReasonEnum(reason) {
      return reason in ['spam', 'harassment', 'hate', 'sexual', 'violence', 'scam', 'other'];
    }

    function reportBaseKeys() {
      return ['reportId', 'reporterUid', 'targetType', 'targetUid', 'contentId', 'conversationId', 'messageId', 'reelId', 'commentId', 'reason', 'details', 'createdAt', 'status', 'moderatedAt', 'moderatedByUid'];
    }

    // Step 39.1: a report is captured by its reporter but moderated by a
    // trusted admin-claim-gated Cloud Function (see functions/src/index.ts's
    // dismissReport), never by a client write — so report creation must
    // pin the moderation fields to their exact initial state. There is no
    // client-side path that ever changes them afterward (allow update: if
    // false, below, for everyone including the reporter).
    function isValidReportBase(data) {
      return data.reporterUid == request.auth.uid
        && isValidReportReasonEnum(data.reason)
        && (data.details == null || (data.details is string && data.details.size() <= 1000))
        && isServerTimestamp(data.createdAt)
        && data.status == 'open'
        && data.moderatedAt == null
        && data.moderatedByUid == null
        && data.keys().hasOnly(reportBaseKeys());
    }

    function isValidUserReport(reportId, data) {
      return data.targetType == 'user'
        && data.targetUid is string
        && data.targetUid != request.auth.uid
        && data.contentId == null
        && data.conversationId == null
        && data.messageId == null
        && data.reelId == null
        && data.commentId == null
        && reportId == 'user_' + request.auth.uid + '_' + data.targetUid
        && exists(/databases/$(database)/documents/publicProfiles/$(data.targetUid));
    }

    function isValidContentReport(reportId, data) {
      let contentPath = /databases/$(database)/documents/content/$(data.contentId);
      return data.targetType == 'content'
        && data.contentId is string
        && data.conversationId == null
        && data.messageId == null
        && data.reelId == null
        && data.commentId == null
        && reportId == 'content_' + request.auth.uid + '_' + data.contentId
        && exists(contentPath)
        && get(contentPath).data.status == 'published'
        && data.targetUid == get(contentPath).data.authorUid
        && data.targetUid != request.auth.uid;
    }

    function isValidMessageReport(reportId, data) {
      let convPath = /databases/$(database)/documents/conversations/$(data.conversationId);
      let msgPath = /databases/$(database)/documents/conversations/$(data.conversationId)/messages/$(data.messageId);
      return data.targetType == 'message'
        && data.conversationId is string
        && data.messageId is string
        && data.contentId == null
        && data.reelId == null
        && data.commentId == null
        && exists(convPath)
        && request.auth.uid in get(convPath).data.participantUids
        && exists(msgPath)
        && get(msgPath).data.senderUid != request.auth.uid
        && data.targetUid == get(msgPath).data.senderUid
        && reportId == 'message_' + request.auth.uid + '_' + data.messageId;
    }

    // Reel is not content/{contentId} (see reels/{reelId} above), so a
    // Reel report references reelId directly rather than reusing
    // isValidContentReport. Requires the Reel to be published (an
    // "uploading" draft's authorUid isn't public information worth
    // reporting yet, and no UI ever offers Report on one), the claimed
    // targetUid to exactly equal the Reel's real author, and — like every
    // other report type — the reporter can't target themselves.
    function isValidReelReport(reportId, data) {
      let reelPath = /databases/$(database)/documents/reels/$(data.reelId);
      return data.targetType == 'reel'
        && data.reelId is string
        && data.contentId == null
        && data.conversationId == null
        && data.messageId == null
        && data.commentId == null
        && exists(reelPath)
        && get(reelPath).data.status == 'published'
        && data.targetUid == get(reelPath).data.authorUid
        && data.targetUid != request.auth.uid
        && reportId == 'reel_' + request.auth.uid + '_' + data.reelId;
    }

    // Reporting one specific comment on a Reel — distinct from
    // isValidReelReport above (which reports the Reel/video itself).
    // Requires the parent Reel to still be published and the exact
    // comment to still exist, the claimed targetUid to equal that
    // comment's real author, and the reporter can't target themselves.
    function isValidReelCommentReport(reportId, data) {
      let reelPath = /databases/$(database)/documents/reels/$(data.reelId);
      let commentPath = /databases/$(database)/documents/reels/$(data.reelId)/comments/$(data.commentId);
      return data.targetType == 'reel_comment'
        && data.reelId is string
        && data.commentId is string
        && data.contentId == null
        && data.conversationId == null
        && data.messageId == null
        && exists(reelPath)
        && get(reelPath).data.status == 'published'
        && exists(commentPath)
        && data.targetUid == get(commentPath).data.authorUid
        && data.targetUid != request.auth.uid
        && reportId == 'reel_comment_' + request.auth.uid + '_' + data.commentId;
    }

    function isValidReportCreate(reportId, data) {
      return isValidReportBase(data)
        && (
          isValidUserReport(reportId, data)
          || isValidContentReport(reportId, data)
          || isValidMessageReport(reportId, data)
          || isValidReelReport(reportId, data)
          || isValidReelCommentReport(reportId, data)
        );
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
