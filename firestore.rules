rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validates that a field was set via serverTimestamp(), not an
    // arbitrary client-supplied value.
    function isServerTimestamp(value) {
      return value == request.time;
    }

    // users/{uid} — private profile, readable and creatable only by its
    // own owner. No update/delete yet: profile editing is a future step
    // with its own explicit rules.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.cityName is string
        && request.resource.data.countryCode is string
        && request.resource.data.cityKey is string
        && request.resource.data.interests is list
        && request.resource.data.accountType == 'personal'
        && request.resource.data.onboardingCompleted is bool
        && isServerTimestamp(request.resource.data.createdAt)
        && isServerTimestamp(request.resource.data.updatedAt)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'username', 'usernameLower',
          'cityName', 'countryCode', 'cityKey', 'interests',
          'accountType', 'onboardingCompleted', 'createdAt', 'updatedAt'
        ]);
    }

    // usernames/{usernameLower} — a uniqueness index. Any signed-in user
    // may check whether a single username is taken (get, not list); only
    // the reserving user may create their own reservation, and it can
    // never be updated or deleted once created.
    match /usernames/{usernameLower} {
      allow get: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && usernameLower.matches('^[a-z0-9_]{3,24}$')
        && isServerTimestamp(request.resource.data.createdAt)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
    }

    // publicProfiles/{uid} — the social-facing counterpart to the private
    // users/{uid} document (see src/types/social.ts). Only public-safe
    // fields, never email/GPS/tokens/private settings. Every field is
    // validated server-side against the caller's own private profile on
    // create, so a modified client can never publish someone else's name,
    // a different city, or a fabricated identity. users/{uid} itself stays
    // fully private — this collection exists specifically so we never have
    // to make it publicly readable.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isValidPublicProfileCreate(uid, request.resource.data);

      // Profile editing is a later step — nothing to validate yet.
      allow update: if false;

      // Social identity documents aren't independently erasable from
      // account lifecycle yet.
      allow delete: if false;
    }

    function isValidPublicProfileCreate(uid, data) {
      // getAfter()/existsAfter(), not get()/exists(): the atomic onboarding
      // transaction creates users/{uid} and publicProfiles/{uid} together in
      // one transaction, so a plain get() here would only see the
      // pre-transaction snapshot — users/{uid} wouldn't exist yet from that
      // vantage point for a brand-new user, and this would always fail. This
      // is the exact same pairing pattern as the participants/stats rules.
      let profile = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return existsAfter(/databases/$(database)/documents/users/$(uid))
        && profile.onboardingCompleted == true
        && data.uid == uid
        && data.displayName == profile.displayName
        && data.username == profile.username
        && data.usernameLower == profile.usernameLower
        && data.cityName == profile.cityName
        && data.countryCode == profile.countryCode
        && data.cityKey == profile.cityKey
        && data.interests == profile.interests
        && data.accountType == profile.accountType
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'cityName',
          'countryCode', 'cityKey', 'interests', 'accountType', 'createdAt', 'updatedAt'
        ]);
    }

    // follows/{followerUid}_{followingUid} — a directed edge in the social
    // graph (see src/services/following.ts). The deterministic ID is what
    // guarantees at most one follow per (follower, following) pair: a
    // second create attempt for the same pair lands on the same document,
    // which is a rules "update" (denied below), not a second "create".
    match /follows/{followId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isValidFollowCreate(followId, request.resource.data);

      allow update: if false;

      // Only the follower can remove their own follow — a followed user
      // can't unilaterally strip someone else's follow edge in Step 11.
      allow delete: if isSignedIn() && resource.data.followerUid == request.auth.uid;
    }

    function isValidFollowCreate(followId, data) {
      return data.followerUid == request.auth.uid
        && data.followingUid != request.auth.uid
        && followId == data.followerUid + '_' + data.followingUid
        && exists(/databases/$(database)/documents/publicProfiles/$(data.followingUid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly(['followerUid', 'followingUid', 'createdAt']);
    }

    // places/{placeId} — real public physical locations (see
    // src/types/place.ts). Ordinary users can only READ active Places.
    // Step 13 has no place-creation UI at all — Places are seeded only by
    // trusted tooling using the same `firebase login` CLI session as the
    // rest of this project's scripts (see scripts/delete-test-documents.cjs
    // for the equivalent pattern), never by ordinary client writes. This is
    // deliberate: unrestricted client writes would let anyone add fake
    // restaurants/venues to the public map. Business accounts, place
    // claiming, and user submissions are future steps, not this one.
    match /places/{placeId} {
      allow read: if isSignedIn() && resource.data.status == 'active';

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // content/{contentId} — the unified root collection for posts,
    // activities, and events (see src/types/content.ts). Every document's
    // author/city fields are validated against the author's own private
    // users/{uid} profile below, so a modified client can never impersonate
    // another user or another city — without making users/{uid} itself
    // publicly readable.
    match /content/{contentId} {
      // Base field set shared by every content type. placeId is always
      // present (a string places/{placeId} or null) — see isValidPlaceLink.
      function baseContentKeys() {
        return [
          'contentId', 'type', 'authorUid', 'authorDisplayName', 'authorUsername',
          'cityName', 'countryCode', 'cityKey', 'categoryId', 'placeId',
          'status', 'visibility', 'createdAt', 'updatedAt'
        ];
      }

      function isValidPostShape(data) {
        return data.type == 'post'
          && data.body is string
          && data.body.size() > 0
          && data.body.size() <= 1000
          && data.keys().hasAll(baseContentKeys().concat(['body']))
          && data.keys().hasOnly(baseContentKeys().concat(['body', 'placeName']))
          && (!('placeName' in data) || (data.placeName is string && data.placeName.size() <= 200));
      }

      function isValidActivityShape(data) {
        return data.type == 'activity'
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
          && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 200
          && data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.startsAt < data.endsAt
          && data.keys().hasAll(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName']))
          && data.keys().hasOnly(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName', 'maxParticipants']))
          && (!('maxParticipants' in data) || (data.maxParticipants is int && data.maxParticipants > 0 && data.maxParticipants <= 500));
      }

      function isValidEventShape(data) {
        return data.type == 'event'
          && data.title is string && data.title.size() > 0 && data.title.size() <= 120
          && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
          && data.placeName is string && data.placeName.size() > 0 && data.placeName.size() <= 200
          && data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.startsAt < data.endsAt
          && data.keys().hasAll(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName']))
          && data.keys().hasOnly(baseContentKeys().concat(['title', 'description', 'startsAt', 'endsAt', 'placeName']));
      }

      // If placeId is set, the linked place must exist, be active, be in
      // the SAME city as this content, and content.placeName must exactly
      // match the place's real name — otherwise a modified client could
      // link Karlstad content to a Stockholm place, or attach a spoofed
      // placeName to a real place. exists() is checked before any get()
      // on the same path, so a nonexistent/mistyped placeId is denied
      // rather than causing get() to fail the whole rule evaluation.
      function isValidPlaceLink(data) {
        return data.placeId == null
          || (
            data.placeId is string
            && data.placeId.size() > 0
            && exists(/databases/$(database)/documents/places/$(data.placeId))
            && get(/databases/$(database)/documents/places/$(data.placeId)).data.status == 'active'
            && get(/databases/$(database)/documents/places/$(data.placeId)).data.cityKey == data.cityKey
            && get(/databases/$(database)/documents/places/$(data.placeId)).data.name == data.placeName
          );
      }

      // Fetches the caller's own private profile once (Firestore rules
      // cache repeated get()/exists() calls to the same path within one
      // evaluation, so this costs a single read regardless of how many
      // times `profile` is referenced below) and checks the full author +
      // city snapshot on the incoming document against it.
      function isValidContentCreate(data) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && profile.onboardingCompleted == true
          && data.contentId == contentId
          && data.authorUid == request.auth.uid
          && data.authorDisplayName == profile.displayName
          && data.authorUsername == profile.username
          && data.cityName == profile.cityName
          && data.countryCode == profile.countryCode
          && data.cityKey == profile.cityKey
          && data.status == 'published'
          && data.visibility == 'city'
          && data.categoryId is string
          && data.categoryId.size() > 0
          && isValidPlaceLink(data)
          && isServerTimestamp(data.createdAt)
          && isServerTimestamp(data.updatedAt)
          && (isValidPostShape(data) || isValidActivityShape(data) || isValidEventShape(data));
      }

      // Published content is readable by any signed-in user (this also
      // governs list/query results — Firestore evaluates this per matched
      // document). Not scoped to the reader's own city: browsing other
      // cities is part of the product.
      allow read: if isSignedIn() && resource.data.status == 'published';

      allow create: if isSignedIn() && isValidContentCreate(request.resource.data);

      // No edit UI exists yet, so there's nothing to validate "which
      // fields are safely mutable" against — deny entirely for now rather
      // than design that validation speculatively. Revisit when an actual
      // edit flow exists.
      allow update: if false;

      // Disabled as of Step 10: content now has five possible subcollections
      // (participants, stats, responses, likes, comments) and Firestore
      // never cascade-deletes them when the parent document is removed.
      // There is no safe production cascade-delete workflow yet (and no
      // client "delete content" UI), so allowing a client to delete the
      // parent alone would leave those subcollections permanently orphaned.
      // Revisit once a real delete flow (Cloud Function or equivalent) exists.
      allow delete: if false;

      // content/{contentId}/participants/{uid} — one document per user who
      // joined an Activity. Paired 1:1 with a content/{contentId}/stats/activity
      // increment/decrement in the same atomic write (see below): a
      // participant document can never be created or deleted without the
      // matching counter change actually landing, and vice versa.
      match /participants/{uid} {
        function participantParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        allow read: if isSignedIn()
          && participantParent().type == 'activity'
          && participantParent().status == 'published';

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && isValidParticipantCreate(contentId, request.resource.data);

        // No edit surface for participation — you're either joined or not.
        allow update: if false;

        // A lone delete (no paired stats write in the same batch) would
        // otherwise pass an "existsAfter" check trivially — the stats doc is
        // untouched, so it still exists. We must verify its VALUE actually
        // decremented by exactly 1, which forces the client to include a
        // correctly-computed stats write in the same transaction.
        allow delete: if isOwner(uid)
          && existsAfter(/databases/$(database)/documents/content/$(contentId)/stats/activity)
          && getAfter(/databases/$(database)/documents/content/$(contentId)/stats/activity).data.participantCount
             == get(/databases/$(database)/documents/content/$(contentId)/stats/activity).data.participantCount - 1;
      }

      function isValidParticipantCreate(contentId, data) {
        let activity = get(/databases/$(database)/documents/content/$(contentId)).data;
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let statsPath = /databases/$(database)/documents/content/$(contentId)/stats/activity;
        return activity.type == 'activity'
          && activity.status == 'published'
          && activity.endsAt > request.time
          && data.uid == request.auth.uid
          && data.displayName == profile.displayName
          && data.username == profile.username
          && isServerTimestamp(data.joinedAt)
          && data.keys().hasOnly(['uid', 'displayName', 'username', 'joinedAt'])
          // The paired counter write must land in the same batch/transaction,
          // and must be exactly the correctly-incremented value — same
          // reasoning as the delete rule above (existence alone isn't enough).
          && existsAfter(statsPath)
          && getAfter(statsPath).data.participantCount == (exists(statsPath) ? get(statsPath).data.participantCount + 1 : 1);
      }

      // content/{contentId}/stats/activity — a single document holding the
      // live participant count, since maxParticipants needs a value that's
      // safe under concurrent joins without reading every participant.
      // Every increment/decrement must be exactly 1 and paired with the
      // caller's own participant document actually appearing/disappearing —
      // a client can never simply write participantCount directly.
      match /stats/activity {
        function statsParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        function isValidStatsShape(data) {
          return data.participantCount is int
            && data.participantCount >= 0
            && isServerTimestamp(data.updatedAt)
            && data.keys().hasOnly(['participantCount', 'updatedAt']);
        }

        function participantPath() {
          return /databases/$(database)/documents/content/$(contentId)/participants/$(request.auth.uid);
        }

        allow read: if isSignedIn()
          && statsParent().type == 'activity'
          && statsParent().status == 'published';

        // First join ever for this Activity — the stats doc doesn't exist yet.
        allow create: if isSignedIn()
          && isValidStatsShape(request.resource.data)
          && request.resource.data.participantCount == 1
          && !exists(participantPath())
          && existsAfter(participantPath())
          && (!('maxParticipants' in statsParent()) || 1 <= statsParent().maxParticipants);

        // Every later join (+1) or leave (-1) for this Activity.
        allow update: if isSignedIn()
          && isValidStatsShape(request.resource.data)
          && (
            (
              !exists(participantPath())
              && existsAfter(participantPath())
              && request.resource.data.participantCount == resource.data.participantCount + 1
              && (!('maxParticipants' in statsParent()) || request.resource.data.participantCount <= statsParent().maxParticipants)
            )
            || (
              exists(participantPath())
              && !existsAfter(participantPath())
              && request.resource.data.participantCount == resource.data.participantCount - 1
            )
          );

        allow delete: if false;
      }

      // content/{contentId}/responses/{uid} — one document per user's
      // Interested/Going response to an Event. Switching state updates this
      // same document; there is deliberately no separate counter here (Step
      // 9 uses aggregation count queries instead — see src/services/engagement.ts).
      match /responses/{uid} {
        function responseParent() {
          return get(/databases/$(database)/documents/content/$(contentId)).data;
        }

        allow read: if isSignedIn()
          && responseParent().type == 'event'
          && responseParent().status == 'published';

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && isValidResponseCreate(contentId, request.resource.data);

        allow update: if isOwner(uid)
          && isValidResponseUpdate(contentId, request.resource.data, resource.data);

        allow delete: if isOwner(uid);
      }

      function isValidResponseCreate(contentId, data) {
        let event = get(/databases/$(database)/documents/content/$(contentId)).data;
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return event.type == 'event'
          && event.status == 'published'
          && event.endsAt > request.time
          && data.uid == request.auth.uid
          && data.displayName == profile.displayName
          && data.username == profile.username
          && (data.status == 'interested' || data.status == 'going')
          && isServerTimestamp(data.createdAt)
          && isServerTimestamp(data.updatedAt)
          && data.keys().hasOnly(['uid', 'displayName', 'username', 'status', 'createdAt', 'updatedAt']);
      }

      function isValidResponseUpdate(contentId, newData, oldData) {
        let event = get(/databases/$(database)/documents/content/$(contentId)).data;
        return event.type == 'event'
          && event.endsAt > request.time
          && (newData.status == 'interested' || newData.status == 'going')
          && newData.uid == oldData.uid
          && newData.displayName == oldData.displayName
          && newData.username == oldData.username
          && newData.createdAt == oldData.createdAt
          && isServerTimestamp(newData.updatedAt)
          && newData.keys().hasOnly(['uid', 'displayName', 'username', 'status', 'createdAt', 'updatedAt']);
      }

      // content/{contentId}/likes/{uid} — one document per user who liked
      // this Post/Activity/Event, keyed by the liker's own uid (which is
      // itself what guarantees at most one Like per user — no separate
      // uniqueness check needed). No counter to keep paired: like counts
      // come from a getCountFromServer() aggregation query instead (see
      // src/services/socialEngagement.ts).
      match /likes/{uid} {
        function likeParentPublished() {
          return get(/databases/$(database)/documents/content/$(contentId)).data.status == 'published';
        }

        allow read: if isSignedIn() && likeParentPublished();

        allow create: if isSignedIn()
          && uid == request.auth.uid
          && likeParentPublished()
          && request.resource.data.uid == request.auth.uid
          && isServerTimestamp(request.resource.data.createdAt)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt']);

        // Re-liking an existing Like doc is an update, not a create — denying
        // update here is what actually prevents a duplicate/overwritten Like,
        // not a separate "already exists" check on create.
        allow update: if false;

        allow delete: if isOwner(uid);
      }

      // content/{contentId}/comments/{commentId} — top-level comments only
      // for Step 10 (no replies/threads). authorDisplayName/authorUsername
      // are a public-safe snapshot of the commenter's own profile, verified
      // against it below — same pattern as content authorship itself.
      match /comments/{commentId} {
        function commentParentPublished() {
          return get(/databases/$(database)/documents/content/$(contentId)).data.status == 'published';
        }

        allow read: if isSignedIn() && commentParentPublished();

        allow create: if isSignedIn() && isValidCommentCreate(contentId, commentId, request.resource.data);

        // Comment editing is a later step.
        allow update: if false;

        // Only the author — not the content's author — can delete a
        // comment for now. Moderation-by-content-author comes later.
        allow delete: if isOwner(resource.data.authorUid);
      }

      function isValidCommentCreate(contentId, commentId, data) {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && profile.onboardingCompleted == true
          && get(/databases/$(database)/documents/content/$(contentId)).data.status == 'published'
          && data.commentId == commentId
          && data.authorUid == request.auth.uid
          && data.authorDisplayName == profile.displayName
          && data.authorUsername == profile.username
          && data.body is string
          && data.body.size() > 0
          && data.body.size() <= 500
          && isServerTimestamp(data.createdAt)
          && isServerTimestamp(data.updatedAt)
          && data.keys().hasOnly(['commentId', 'authorUid', 'authorDisplayName', 'authorUsername', 'body', 'createdAt', 'updatedAt']);
      }
    }

    // notifications/{notificationId} — one social notification per Like,
    // Comment, or Follow (see src/types/notification.ts). These are always
    // written atomically with their underlying action (writeBatch, in
    // src/services/socialEngagement.ts and src/services/following.ts), and
    // every create here is independently re-validated against that action —
    // a client can never fabricate a notification ("X followed you" with no
    // real follow edge) no matter what it sends.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;

      allow create: if isSignedIn()
        && isValidNotificationActor(request.resource.data)
        && isValidNotificationBase(notificationId, request.resource.data)
        && (
          isValidLikeNotification(notificationId, request.resource.data)
          || isValidCommentNotification(notificationId, request.resource.data)
          || isValidFollowNotification(notificationId, request.resource.data)
        );

      allow update: if isSignedIn() && isValidNotificationUpdate(request.resource.data, resource.data);

      allow delete: if isSignedIn() && isValidNotificationDelete(resource.data);
    }

    // The actor snapshot (actorDisplayName/actorUsername) must match the
    // caller's OWN public profile, and a notification can never target
    // yourself — self-like/self-comment/self-follow never produce one (see
    // the service layer, which already skips the write; this is the
    // server-side backstop).
    function isValidNotificationActor(data) {
      let profile = get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data;
      return data.actorUid == request.auth.uid
        && data.recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && data.actorDisplayName == profile.displayName
        && data.actorUsername == profile.username;
    }

    function isValidNotificationBase(notificationId, data) {
      return data.notificationId == notificationId
        && data.read == false
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.keys().hasOnly([
          'notificationId', 'recipientUid', 'actorUid', 'actorDisplayName', 'actorUsername',
          'type', 'contentId', 'commentId', 'previewText', 'read', 'createdAt', 'updatedAt'
        ]);
    }

    // The deterministic ID ties this doc to one exact (content, actor) pair,
    // and existsAfter() on the Like doc proves a real Like landed in the
    // same batch — not just a claim that one exists.
    function isValidLikeNotification(notificationId, data) {
      let contentPath = /databases/$(database)/documents/content/$(data.contentId);
      return data.type == 'like'
        && data.contentId is string
        && data.commentId == null
        && data.previewText == null
        && notificationId == 'like_' + data.contentId + '_' + data.actorUid
        && exists(contentPath)
        && get(contentPath).data.status == 'published'
        && get(contentPath).data.authorUid == data.recipientUid
        && existsAfter(/databases/$(database)/documents/content/$(data.contentId)/likes/$(data.actorUid));
    }

    // Same idea for comments: the ID is tied to one exact comment, and the
    // comment must actually exist (in the same batch) and be authored by
    // the notification's claimed actor.
    function isValidCommentNotification(notificationId, data) {
      let contentPath = /databases/$(database)/documents/content/$(data.contentId);
      let commentPath = /databases/$(database)/documents/content/$(data.contentId)/comments/$(data.commentId);
      return data.type == 'comment'
        && data.contentId is string
        && data.commentId is string
        && notificationId == 'comment_' + data.commentId
        && (data.previewText == null || (data.previewText is string && data.previewText.size() <= 500))
        && exists(contentPath)
        && get(contentPath).data.status == 'published'
        && get(contentPath).data.authorUid == data.recipientUid
        && existsAfter(commentPath)
        && getAfter(commentPath).data.authorUid == data.actorUid;
    }

    // And for follows: the ID is tied to one exact (actor, recipient) edge,
    // and that edge must actually exist (in the same batch) with matching
    // follower/following uids.
    function isValidFollowNotification(notificationId, data) {
      let followPath = /databases/$(database)/documents/follows/$(data.actorUid + '_' + data.recipientUid);
      return data.type == 'follow'
        && data.contentId == null
        && data.commentId == null
        && data.previewText == null
        && notificationId == 'follow_' + data.actorUid + '_' + data.recipientUid
        && exists(/databases/$(database)/documents/publicProfiles/$(data.recipientUid))
        && existsAfter(followPath)
        && getAfter(followPath).data.followerUid == data.actorUid
        && getAfter(followPath).data.followingUid == data.recipientUid;
    }

    // Only the recipient, and only to toggle read state — every other
    // field, including actorUid/recipientUid/type, must stay byte-identical
    // to what create validated. Nobody can "retarget" or "relabel" an
    // existing notification via update.
    function isValidNotificationUpdate(newData, oldData) {
      return oldData.recipientUid == request.auth.uid
        && newData.notificationId == oldData.notificationId
        && newData.recipientUid == oldData.recipientUid
        && newData.actorUid == oldData.actorUid
        && newData.actorDisplayName == oldData.actorDisplayName
        && newData.actorUsername == oldData.actorUsername
        && newData.type == oldData.type
        && newData.contentId == oldData.contentId
        && newData.commentId == oldData.commentId
        && newData.previewText == oldData.previewText
        && newData.createdAt == oldData.createdAt
        && newData.read is bool
        && isServerTimestamp(newData.updatedAt)
        && newData.keys().hasOnly([
          'notificationId', 'recipientUid', 'actorUid', 'actorDisplayName', 'actorUsername',
          'type', 'contentId', 'commentId', 'previewText', 'read', 'createdAt', 'updatedAt'
        ]);
    }

    // Recipients can always clear their own inbox. Actors may only delete a
    // notification they generated as part of genuinely undoing the same
    // action (unlike/delete-comment/unfollow) in the same batch — this
    // keeps "notification exists iff the action exists" true from the
    // actor's side too, instead of letting an actor delete a notification
    // while leaving the Like/Comment/Follow it came from intact.
    function isValidNotificationDelete(data) {
      return data.recipientUid == request.auth.uid
        || (
          data.actorUid == request.auth.uid
          && (
            (data.type == 'like' && !existsAfter(/databases/$(database)/documents/content/$(data.contentId)/likes/$(data.actorUid)))
            || (data.type == 'comment' && !existsAfter(/databases/$(database)/documents/content/$(data.contentId)/comments/$(data.commentId)))
            || (data.type == 'follow' && !existsAfter(/databases/$(database)/documents/follows/$(data.actorUid + '_' + data.recipientUid)))
          )
        );
    }

    // conversations/{conversationId} — a private 1:1 direct-message thread
    // between exactly two users (see src/services/messages.ts and
    // src/types/message.ts). conversationId is the canonical
    // `{lowerUid}_{higherUid}` pairing — Firestore Rules support the same
    // lexicographic `<` ordering on strings that JavaScript's `<` uses for
    // ASCII uids, so the client and these rules always agree on which uid
    // sorts first. This is what guarantees at most one 1:1 conversation
    // per user pair, no matter who starts it — verified explicitly by the
    // rules test suite's "conversation uniqueness" checks, not assumed.
    match /conversations/{conversationId} {
      // resource == null (the conversation doesn't exist yet) is allowed
      // here on purpose: a nonexistent document has no data to protect, and
      // sendMessage's own existence pre-check (does this pair already have
      // a conversation?) needs to be able to ask that question for a
      // conversation that legitimately might not exist yet — without this,
      // that pre-check read itself would be denied (resource.data would be
      // null.data, an evaluation error) before a first message could ever
      // be sent.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantUids);

      allow create: if isSignedIn() && isValidConversationCreate(conversationId, request.resource.data);

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantUids
        && (isValidConversationSend(request.resource.data, resource.data) || isValidMarkRead(request.resource.data, resource.data));

      // Firestore never cascade-deletes the messages subcollection, and
      // there's no delete UI yet — same reasoning as content delete above.
      allow delete: if false;

      // conversations/{conversationId}/messages/{messageId} — text-only,
      // create + read only (no edit/delete in Step 16 — see
      // isValidMessageCreate). Always paired with a Conversation
      // create/update in the same transaction (src/services/messages.ts),
      // and independently re-validated against it below so a modified
      // client can never write a message the Conversation doesn't
      // reference as its latest.
      match /messages/{messageId} {
        function conversationPath() {
          return /databases/$(database)/documents/conversations/$(conversationId);
        }

        // Same reasoning as the conversations read rule above: the Chat
        // screen queries this subcollection immediately on open, before
        // any message (and therefore before the Conversation itself) may
        // exist yet. A plain get() on a nonexistent Conversation throws in
        // rules, so that query must be allowed to return "nothing" rather
        // than error — there's no data to protect when the conversation
        // doesn't exist. Once it exists, only real participants may read.
        allow read: if isSignedIn()
          && (!exists(conversationPath()) || request.auth.uid in get(conversationPath()).data.participantUids);

        allow create: if isSignedIn() && isValidMessageCreate(conversationId, messageId, request.resource.data);

        allow update: if false;
        allow delete: if false;
      }
    }

    function otherParticipant(participantUids, uid) {
      return participantUids[0] == uid ? participantUids[1] : participantUids[0];
    }

    function conversationBaseKeys() {
      return [
        'conversationId', 'participantUids', 'lastMessageId', 'lastMessageText',
        'lastMessageSenderUid', 'lastMessageAt', 'unreadCounts', 'createdAt', 'updatedAt'
      ];
    }

    // Requires the two-uid array to be stored in the exact SAME sorted
    // order the ID is derived from — one canonical representation per
    // pair, not two, and self-conversations are impossible since a value
    // can never be strictly less than itself.
    function isValidParticipantPair(participantUids) {
      return participantUids is list
        && participantUids.size() == 2
        && participantUids[0] is string
        && participantUids[1] is string
        && participantUids[0] < participantUids[1];
    }

    function isValidConversationCreate(conversationId, data) {
      let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(data.lastMessageId);
      return isValidParticipantPair(data.participantUids)
        && conversationId == data.participantUids[0] + '_' + data.participantUids[1]
        && request.auth.uid in data.participantUids
        && exists(/databases/$(database)/documents/publicProfiles/$(data.participantUids[0]))
        && exists(/databases/$(database)/documents/publicProfiles/$(data.participantUids[1]))
        && data.conversationId == conversationId
        && data.lastMessageSenderUid == request.auth.uid
        && data.lastMessageText is string
        && isServerTimestamp(data.lastMessageAt)
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.updatedAt)
        && data.unreadCounts.size() == 2
        && data.unreadCounts[request.auth.uid] == 0
        && data.unreadCounts[otherParticipant(data.participantUids, request.auth.uid)] == 1
        && data.keys().hasOnly(conversationBaseKeys())
        // The paired first Message must exist (in this same transaction)
        // and match the Conversation's claimed last-message fields exactly
        // — a client can never point lastMessage* at a message that isn't
        // really there, or that says something different.
        && existsAfter(messagePath)
        && getAfter(messagePath).data.senderUid == request.auth.uid
        && getAfter(messagePath).data.body == data.lastMessageText
        && getAfter(messagePath).data.createdAt == data.lastMessageAt;
    }

    // A normal send on an ALREADY-EXISTING conversation: identity fields
    // are immutable, and the last-message snapshot + unread counts can
    // only move in the one direction a real send actually moves them.
    function isValidConversationSend(newData, oldData) {
      let sender = request.auth.uid;
      let other = otherParticipant(oldData.participantUids, sender);
      let messagePath = /databases/$(database)/documents/conversations/$(oldData.conversationId)/messages/$(newData.lastMessageId);
      return newData.conversationId == oldData.conversationId
        && newData.participantUids == oldData.participantUids
        && newData.createdAt == oldData.createdAt
        && newData.lastMessageId != oldData.lastMessageId
        && newData.lastMessageSenderUid == sender
        && newData.lastMessageText is string
        && isServerTimestamp(newData.lastMessageAt)
        && isServerTimestamp(newData.updatedAt)
        && newData.unreadCounts.size() == 2
        && newData.unreadCounts[sender] == 0
        && newData.unreadCounts[other] == oldData.unreadCounts[other] + 1
        && newData.keys().hasOnly(conversationBaseKeys())
        // The paired new Message must exist (in this same transaction)
        // and match exactly — same pairing guarantee as create.
        && existsAfter(messagePath)
        && getAfter(messagePath).data.senderUid == sender
        && getAfter(messagePath).data.body == newData.lastMessageText
        && getAfter(messagePath).data.createdAt == newData.lastMessageAt;
    }

    // markConversationRead: the ONLY thing allowed to change is the
    // caller's own unreadCounts entry, and only down to 0. Every other
    // field — including the other participant's unread count — must stay
    // byte-identical to what was there before.
    function isValidMarkRead(newData, oldData) {
      let uid = request.auth.uid;
      let other = otherParticipant(oldData.participantUids, uid);
      return newData.conversationId == oldData.conversationId
        && newData.participantUids == oldData.participantUids
        && newData.createdAt == oldData.createdAt
        && newData.updatedAt == oldData.updatedAt
        && newData.lastMessageId == oldData.lastMessageId
        && newData.lastMessageText == oldData.lastMessageText
        && newData.lastMessageSenderUid == oldData.lastMessageSenderUid
        && newData.lastMessageAt == oldData.lastMessageAt
        && newData.unreadCounts.size() == 2
        && newData.unreadCounts[uid] == 0
        && newData.unreadCounts[other] == oldData.unreadCounts[other]
        && newData.keys().hasOnly(conversationBaseKeys());
    }

    function isValidMessageCreate(conversationId, messageId, data) {
      let convPath = /databases/$(database)/documents/conversations/$(conversationId);
      let convAfter = getAfter(convPath).data;
      return existsAfter(convPath)
        && request.auth.uid in convAfter.participantUids
        && data.messageId == messageId
        && data.senderUid == request.auth.uid
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 1000
        && isServerTimestamp(data.createdAt)
        && data.keys().hasOnly(['messageId', 'senderUid', 'body', 'createdAt'])
        // The paired Conversation write (whether this message is the
        // FIRST one — creating the Conversation in the same transaction —
        // or a later one on an existing Conversation) must reference this
        // exact message as its latest. Checking the POST-write state
        // (getAfter) rather than the pre-write state is what makes this
        // one check correct for both cases.
        && convAfter.lastMessageId == messageId
        && convAfter.lastMessageSenderUid == request.auth.uid
        && convAfter.lastMessageText == data.body
        && convAfter.lastMessageAt == data.createdAt;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
