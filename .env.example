# Firebase Web app config (from Firebase Console → Project settings → Your apps).
# These are public client identifiers, not secrets — see README for details.
# Copy this file to .env.local and fill in real values. Never commit .env.local.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Media storage provider — Step 4 foundation, not yet acted on by any
# upload/playback code (see src/services/media/config.ts). A plain mode
# string, never a credential, so EXPO_PUBLIC_ is safe here — unlike R2's
# own access keys, which must NEVER be EXPO_PUBLIC_* (see
# functions/.env.example). Optional: defaults to "firebase" when unset.
# Only "firebase" or "r2" are recognized; anything else also defaults to
# "firebase".
EXPO_PUBLIC_MEDIA_STORAGE_PROVIDER=firebase
